-- Buttons
local function create_btn(text, y_pos, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0.9, 0, 0, 35)
    btn.Position = UDim2.new(0.05, 0, 0, y_pos)
    btn.BackgroundColor3 = Color3.fromRGB(30, 25, 40)
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.GothamSemibold
    btn.TextSize = 13
    btn.Parent = main
    
    local c = Instance.new("UICorner", btn)
    c.CornerRadius = UDim.new(0, 6)
    
    btn.MouseButton1Click:Connect(function()
        callback(btn)
    end)
end

create_btn("ESP: OFF", 40, function(b)
    config.esp = not config.esp
    b.Text = "ESP: " .. (config.esp and "ON" or "OFF")
    b.BackgroundColor3 = config.esp and Color3.fromRGB(100, 50, 180) or Color3.fromRGB(30, 25, 40)
    update_esp()
end)

create_btn("AIMBOT: OFF", 85, function(b)
    config.aimbot = not config.aimbot
    b.Text = "AIMBOT: " .. (config.aimbot and "ON" or "OFF")
    b.BackgroundColor3 = config.aimbot and Color3.fromRGB(100, 50, 180) or Color3.fromRGB(30, 25, 40)
end)

-- Keybind para reabrir
UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.RightShift then
        main.Visible = not main.Visible
    end
end)

-- // LOOPS //
UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.UserInputType == Enum.UserInputType.MouseButton2 then
        aim_held = true
    end
end)

UserInputService.InputEnded:Connect(function(input, gp)
    if input.UserInputType == Enum.UserInputType.MouseButton2 then
        aim_held = false
    end
end)

RunService.RenderStepped:Connect(function()
    update_esp()

    if config.aimbot and aim_held then
        local target = get_closest_player()
        if target then
            local goal = CFrame.new(Camera.CFrame.Position, target.Position)
            Camera.CFrame = Camera.CFrame:Lerp(goal, config.aim_smooth)
        end
    end
end)
