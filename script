-- Retorna a entrada da quest para o nível atual
local function getQuestEntry()
    local level = LocalPlayer.Data and LocalPlayer.Data.Level.Value or 1
    local seaDB = QUEST_DB[CURRENT_SEA]
    if not seaDB then return nil end

    for _, entry in ipairs(seaDB) do
        if level >= entry.minLv and level <= entry.maxLv then
            return entry
        end
    end
    -- Fallback: última entrada que o nível alcance
    local fallback = nil
    for _, entry in ipairs(seaDB) do
        if level >= entry.minLv then fallback = entry end
    end
    return fallback
end

-- Aceita a missão via InvokeServer (o correto para Blox Fruits)
local function acceptQuest(entry)
    if not entry then return false end
    local ok = pcall(function()
        CommF:InvokeServer("StartQuest", entry.quest, entry.levelQuest)
    end)
    if ok then
        F.LastQuestID = entry.quest
        F.LastQuestTime = tick()
    end
    return ok
end

-- Abandona a missão atual (usado se a quest travar)
local function abandonQuest()
    pcall(function()
        CommF:InvokeServer("AbandonQuest")
    end)
end

-- Verifica se há uma quest ativa lendo a GUI do jogador
local function hasActiveQuest()
    local gui = LocalPlayer:FindFirstChild("PlayerGui")
    if not gui then return false end
    local main = gui:FindFirstChild("Main")
    if not main then return false end
    local quest = main:FindFirstChild("Quest")
    if quest and quest.Visible then
        return true
    end
    return false
end

-- Encontra o NPC da quest no Workspace
local function getQuestNPC(entry)
    local quests = workspace:FindFirstChild("Quests")
    if not quests or not entry then return nil end

    -- Procura por nome que contenha a string do NPC
    for _, npc in pairs(quests:GetChildren()) do
        if npc:IsA("Model") and npc.Name:find(entry.npc) then
            return npc
        end
    end
    -- Fallback: procura por qualquer NPC que tenha "Quest" no nome
    for _, npc in pairs(quests:GetChildren()) do
        if npc:IsA("Model") and npc.Name:find("Quest") then
            return npc
        end
    end
    return nil
end

-- Encontra o mob alvo da quest atual
local function getQuestTarget(entry)
    if not entry then return nil end
    local enemies = workspace:FindFirstChild("Enemies")
    if not enemies then return nil end

    local hrp = getHRP()
    if not hrp then return nil end

    local best, bestDist = nil, math.huge
    for _, mob in pairs(enemies:GetChildren()) do
        if mob:IsA("Model") and mob.Name:find(entry.target)
           and mob:FindFirstChild("HumanoidRootPart")
           and mob:FindFirstChildOfClass("Humanoid") then
            local hum = mob:FindFirstChildOfClass("Humanoid")
            if hum.Health > 0 then
                local d = (mob.HumanoidRootPart.Position - hrp.Position).Magnitude
                if d < bestDist then
                    best, bestDist = mob, d
                end
            end
        end
    end
    return best, bestDist
end

-- ============================================================
-- ATTACK (sem interagir com inventário)
-- ============================================================
local function attack()
    local c = getChar()
    if not c then return end
    local tool = c:FindFirstChildOfClass("Tool")
    if tool then
        pcall(function() tool:Activate() end)
    end
end

-- ============================================================
-- FARM LOOP (com prioridade de missão)
-- ============================================================
local function farmStep()
    local entry = getQuestEntry()
    if not entry then
        F.Status = "sem quest para o nível"
        return
    end

    local hrp = getHRP()
    if not hrp then return end

    -- ========================================================
    -- PASSO 1: VERIFICAR SE HÁ QUEST ATIVA
    -- ========================================================
    local hasQuest = hasActiveQuest()

    if not hasQuest then
        -- Sem missão ativa: ir ao NPC e aceitar
        local questNPC = getQuestNPC(entry)
        local now = tick()

        if questNPC and questNPC:FindFirstChild("HumanoidRootPart") then
            local npcPos = questNPC.HumanoidRootPart.Position
            local dist = (npcPos - hrp.Position).Magnitude

            if dist > 15 then
                F.Status = "indo pro NPC: " .. entry.npc
                tweenTo(npcPos + Vector3.new(0, 5, 0), 0.4)
                task.wait(0.2)
            end

            if dist < 20 then
                F.Status = "aceitando quest: " .. entry.quest
                acceptQuest(entry)
                task.wait(0.8)
            end
        else
            -- NPC não encontrado: ir para a posição conhecida
            F.Status = "NPC nao encontrado, indo para posicao conhecida"
            tweenTo(entry.questPos + Vector3.new(0, 5, 0), 0.4)
            task.wait(0.3)
        end
        return
    end

    -- ========================================================
    -- PASSO 2: QUEST ATIVA -> PROCURAR E ATACAR O MOB
    -- ========================================================
    local target, dist = getQuestTarget(entry)
    if not target then
        F.Status = "procurando: " .. entry.target
        -- Se não achou o mob, ir para a posição conhecida do mob
        tweenTo(entry.monPos + Vector3.new(0, 5, 0), 0.3)
        task.wait(0.2)
        return
    end

    local mobPos = target.HumanoidRootPart.Position
    if dist > 8 then
        F.Status = "atacando: " .. entry.target .. " (" .. math.floor(dist) .. " studs)"
        tweenTo(mobPos + Vector3.new(0, 5, 0), 0.12)
    end

    -- Ataca
    attack()
    task.wait(F.AttackDelay)
end

-- ============================================================
-- ANTI-AFK
-- ============================================================
task.spawn(function()
    while task.wait(3) do
        if not F.AntiAFK then continue end
        pcall(function()
            for _, conn in pairs(getconnections(LocalPlayer.Idled)) do
                conn:Disable()
            end
            VirtualUser:CaptureController()
            VirtualUser:ClickButton2(Vector2.new())
        end)
    end
end)

-- ============================================================
-- MAIN LOOP
-- ============================================================
task.spawn(function()
    while task.wait(0.1) do
        if not F.Enabled then
            F.Status = "parado"
            continue
        end
        local ok, err = pcall(farmStep)
        if not ok then
            warn("[FarmPro]", err)
            F.Status = "erro: " .. tostring(err)
        end
    end
end)

