local function getChar()
    return LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
end

local function getHRP()
    local c = getChar()
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function getHum()
    local c = getChar()
    return c and c:FindFirstChildOfClass("Humanoid")
end

local function getTool()
    local c = getChar()
    return c and c:FindFirstChildOfClass("Tool")
end

-- ============================================================
-- TWEEN MOVER (movimento suave, não teleporte)
-- ============================================================
local function tweenTo(position, duration)
    local hrp = getHRP()
    if not hrp then return false end

    duration = duration or S.tweenSpeed
    local dist = (position - hrp.Position).Magnitude
    local scaled = math.clamp(duration * (dist / 50), 0.08, 1.5)

    local info = TweenInfo.new(scaled, Enum.EasingStyle.Linear)
    local goal = {CFrame = CFrame.new(position)}
    local tween = TweenService:Create(hrp, info, goal)
    tween:Play()
    tween.Completed:Wait()
    return true
end

-- ============================================================
-- WEAPON SELECT (seleção real de arma)
-- ============================================================
local function equipWeapon(weaponType)
    local char = getChar()
    if not char then return end

    local backpack = LocalPlayer:FindFirstChild("Backpack")
    local tool = nil

    if weaponType == "Melee" then
        -- Procura estilo de luta na mochila
        for _, item in pairs(backpack:GetChildren()) do
            if item:IsA("Tool") and (item.Name:find("Combat") or item.Name:find("Fighting")
               or item.Name == "Black Leg" or item.Name == "Electro"
               or item.Name == "Fishman Karate" or item.Name == "Superhuman"
               or item.Name == "Death Step" or item.Name == "Sharkman Karate"
               or item.Name == "Dragon Talon" or item.Name == "Superhuman") then
                tool = item
                break
            end
        end
        -- Fallback: primeira ferramenta sem ser arma
        if not tool then
            for _, item in pairs(backpack:GetChildren()) do
                if item:IsA("Tool") and not item.Name:find("Sword")
                   and not item.Name:find("Gun") then
                    tool = item
                    break
                end
            end
        end

    elseif weaponType == "Sword" then
        for _, item in pairs(backpack:GetChildren()) do
            if item:IsA("Tool") and (item.Name:find("Sword") or item.Name:find("Saber")
               or item.Name:find("Katana") or item.Name:find("Blade")
               or item.Name:find("Cutlass") or item.Name:find("Trident")
               or item.Name == "Dark Blade" or item.Name == "Dragon Trident"
               or item.Name == "Soul Cane" or item.Name == "Midnight Blade") then
                tool = item
                break
            end
        end

    elseif weaponType == "Gun" then
        for _, item in pairs(backpack:GetChildren()) do
            if item:IsA("Tool") and (item.Name:find("Gun") or item.Name:find("Pistol")
               or item.Name:find("Rifle") or item.Name:find("Cannon")
               or item.Name:find("Bow") or item.Name:find("Slingshot")
               or item.Name == "Bizarre Rifle" or item.Name == "Kabucha") then
                tool = item
                break
            end
        end

    elseif weaponType == "Blox Fruit" then
        for _, item in pairs(backpack:GetChildren()) do
            if item:IsA("Tool") and (item.Name:find("Fruit") or item.Name:find("fruit")
               or item.Name == "Dragon" or item.Name == "Leopard"
               or item.Name == "Kitsune" or item.Name == "Dough"
               or item.Name == "Venom" or item.Name == "Shadow") then
                tool = item
                break
            end
        end
    end

    if tool then
        local hum = getHum()
        if hum then
            hum:EquipTool(tool)
        end
        return tool
    end
    return nil
end

-- ============================================================
-- COMBATE
-- ============================================================
local function attack()
    local tool = getTool()
    if tool then
        pcall(function() tool:Activate() end)
    end

    -- Ataque melee via remoto padrão
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    if remotes then
        local comm = remotes:FindFirstChild("CommF_") or remotes:FindFirstChild("Comm")
        if comm then
            pcall(function() comm:FireServer() end)
        end
    end
end

local function useSkills()
    if not S.autoSkill then return end
    if not S.skillZ and not S.skillX and not S.skillC and not S.skillV then return end

    local char = getChar()
    if not char then return end

    -- Habilidades são ativadas via teclas Z, X, C, V
    -- O jogo usa ContextActionService, então simulamos o toque
    local keybinds = {
        [Enum.KeyCode.Z] = S.skillZ,
        [Enum.KeyCode.X] = S.skillX,
        [Enum.KeyCode.C] = S.skillC,
        [Enum.KeyCode.V] = S.skillV,
    }

    for key, enabled in pairs(keybinds) do
        if enabled then
            pcall(function()
                game:GetService("VirtualInputManager"):SendKeyEvent(true, key, false, game)
                task.wait(0.05)
                game:GetService("VirtualInputManager"):SendKeyEvent(false, key, false, game)
            end)
        end
    end
end

-- ============================================================
-- AUTO QUEST
-- ============================================================
local function getQuestNPC()
    local quests = Workspace:FindFirstChild("Quests")
    if not quests then return nil end

    local level = LocalPlayer.Data and LocalPlayer.Data.Level.Value or 0
    local bestNPC = nil
    local bestLevel = 0

    for _, npc in pairs(quests:GetChildren()) do
        if npc:IsA("Model") and npc:FindFirstChild("HumanoidRootPart") then
            local npcLevel = npc:GetAttribute("Level") or 0
            -- Pega o NPC de quest mais próximo do nível atual
            if level >= npcLevel and npcLevel > bestLevel then
                bestNPC = npc
                bestLevel = npcLevel
            end
        end
    end
    return bestNPC
end

local function autoQuest()
    if not S.autoQuest then return end

    local npc = getQuestNPC()
    if not npc then return end

    local hrp = getHRP()
    if not hrp then return end

    local npcPos = npc.HumanoidRootPart.Position
    local dist = (npcPos - hrp.Position).Magnitude

    if dist > 15 then
        tweenTo(npcPos + Vector3.new(0, 5, 0), 0.3)
        task.wait(0.4)
    end

    -- Interage com o NPC de quest (via remoto ou proximidade)
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    if remotes then
        local comm = remotes:FindFirstChild("CommF_") or remotes:FindFirstChild("Comm")
        if comm then
            pcall(function() comm:FireServer("StartQuest") end)
        end
    end
end

-- ============================================================
-- AUTO FARM (com seleção de arma)
-- ============================================================
local function getNearestEnemy()
    local hrp = getHRP()
    if not hrp then return nil end

    local enemies = Workspace:FindFirstChild("Enemies")
    if not enemies then return nil end

    local best, bestDist = nil, math.huge
    for _, mob in pairs(enemies:GetChildren()) do
        if mob:IsA("Model")
           and mob:FindFirstChild("HumanoidRootPart")
           and mob:FindFirstChildOfClass("Humanoid") then
            local hum = mob:FindFirstChildOfClass("Humanoid")
            if hum.Health > 0 then
                local d = (mob.HumanoidRootPart.Position - hrp.Position).Magnitude
                if d < bestDist then
                    best, bestDist = mob, d
                end
            end
        end
    end
    return best, bestDist
end

local function autoFarm()
    if not S.autoFarm then return end

    -- Equipa a arma selecionada
    equipWeapon(S.selectedWeapon)

    local mob, dist = getNearestEnemy()
    if not mob then return end

    local hrp = getHRP()
    if not hrp then return end

    local mobPos = mob.HumanoidRootPart.Position
    local targetPos = mobPos + Vector3.new(0, 5, 0)

    if dist > S.farmDistance then
        tweenTo(targetPos, 0.12)
    end

    -- Ataca
    attack()

    -- Usa habilidades se ativado
    if S.autoSkill then
        useSkills()
    end
end

-- ============================================================
-- AUTO CHEST / FRUIT
-- ============================================================
local function autoChest()
    if not S.autoChest then return end
    local hrp = getHRP()
    if not hrp then return end

    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj.Name == "Chest" and obj:IsA("MeshPart") then
            local d = (obj.Position - hrp.Position).Magnitude
            if d < 600 then
                tweenTo(obj.Position + Vector3.new(0, 3, 0), 0.15)
                task.wait(0.2)
            end
        end
    end
end

local function autoFruit()
    if not S.autoFruit then return end
    local hrp = getHRP()
    if not hrp then return end

    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("Tool") and obj:FindFirstChild("Handle")
           and (obj.Name:find("Fruit") or obj.Name == "Fruit") then
            local d = (obj.Handle.Position - hrp.Position).Magnitude
            if d < 800 then
                tweenTo(obj.Handle.Position, 0.2)
                task.wait(0.3)
            end
        end
    end
end

-- ============================================================
-- KILL AURA (conservador)
-- ============================================================
local function killAura()
    if not S.killAura then return end
    local hrp = getHRP()
    if not hrp then return end

    local mob = getNearestEnemy()
    if not mob then return end

    local d = (mob.HumanoidRootPart.Position - hrp.Position).Magnitude
    if d < 35 then
        attack()
    end
end

