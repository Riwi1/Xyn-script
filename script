-- language: Lua, target: Roblox / Arsenal
-- *versão simplificada e robusta. sem Drawing library, sem UIListLayout complexo.*

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")
local LocalPlayer = Players.LocalPlayer
local Camera = Workspace.CurrentCamera

-- Configurações
local config = {
    esp = false,
    aimbot = false,
    fov = 120,
    aim_smooth = 0.15
}

local aim_held = false
local esp_folder = Instance.new("Folder", game:GetService("CoreGui"))
esp_folder.Name = "XynESP"

-- // ESP SYSTEM //
local function apply_esp(player)
    if player == LocalPlayer then return end
    
    local char = player.Character
    if not char then return end

    local head = char:FindFirstChild("Head")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not head or not hum then return end

    -- Remove se já existir
    local old = esp_folder:FindFirstChild(player.Name)
    if old then old:Destroy() end

    local esp = Instance.new("BillboardGui")
    esp.Name = player.Name
    esp.Adornee = head
    esp.Size = UDim2.new(0, 100, 0, 50)
    esp.StudsOffset = Vector3.new(0, 1.5, 0)
    esp.AlwaysOnTop = true
    esp.Parent = esp_folder

    local box = Instance.new("Frame")
    box.Size = UDim2.new(1, 0, 1, 0)
    box.BackgroundTransparency = 1
    box.BorderSizePixel = 0
    box.Parent = esp
    
    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(150, 90, 255)
    stroke.Thickness = 1
    stroke.Parent = box

    local name = Instance.new("TextLabel")
    name.Size = UDim2.new(1, 0, 0.5, 0)
    name.Position = UDim2.new(0, 0, -0.3, 0)
    name.BackgroundTransparency = 1
    name.Text = player.Name
    name.TextColor3 = Color3.fromRGB(255, 255, 255)
    name.TextStrokeTransparency = 0
    name.TextSize = 14
    name.Font = Enum.Font.GothamBold
    name.Parent = esp

    local dist = Instance.new("TextLabel")
    dist.Size = UDim2.new(1, 0, 0.5, 0)
    dist.Position = UDim2.new(0, 0, 0.9, 0)
    dist.BackgroundTransparency = 1
    dist.TextColor3 = Color3.fromRGB(200, 200, 200)
    dist.TextStrokeTransparency = 0
    dist.TextSize = 12
    dist.Font = Enum.Font.Gotham
    dist.Parent = esp
end

local function update_esp()
    if not config.esp then
        esp_folder.Parent = nil
        return
    else
        esp_folder.Parent = game:GetService("CoreGui")
    end

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local esp = esp_folder:FindFirstChild(player.Name)
            if not esp then
                apply_esp(player)
            else
                local root = player.Character:FindFirstChild("HumanoidRootPart")
                local dist_lbl = esp:FindFirstChild("TextLabel", true)
                if root and dist_lbl then
                    -- Atualiza a distância
                    local d = math.floor((root.Position - Camera.CFrame.Position).Magnitude)
                    local dist_obj = esp:FindFirstChildWhichIsA("TextLabel")
                    if dist_obj then dist_obj.Text = tostring(d) .. "m" end
                end
            end
        end
    end
end

-- // AIMBOT SYSTEM //
local function get_closest_player()
    local closest = nil
    local shortest_dist = config.fov
    local center = Camera.ViewportSize / 2

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local head = player.Character:FindFirstChild("Head")
            local hum = player.Character:FindFirstChildOfClass("Humanoid")
            
            if head and hum and hum.Health > 0 then
                local screen_pos, on_screen = Camera:WorldToViewportPoint(head.Position)
                if on_screen then
                    local dist = (Vector2.new(screen_pos.X, screen_pos.Y) - center).Magnitude
                    if dist < shortest_dist then
                        shortest_dist = dist
                        closest = head
                    end
                end
            end
        end
    end
    return closest
end

