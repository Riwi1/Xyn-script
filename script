-- ============================================================
-- CAMADA 3 — VELOCITY CLAMP (teto de 70 studs/s)
-- ============================================================
local last_pos  = Vector3.new(0, 0, 0)
local last_time = tick()

RunS.Heartbeat:Connect(function()
    local char = LP.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local now = tick()
    local dt  = now - last_time
    if dt > 0.1 then
        last_pos  = hrp.Position
        last_time = now
        return
    end

    local delta = hrp.Position - last_pos
    local horiz = Vector3.new(delta.X, 0, delta.Z).Magnitude / dt
    if horiz > 70 then
        hrp.AssemblyLinearVelocity = Vector3.new(
            hrp.AssemblyLinearVelocity.X * 0.5,
            hrp.AssemblyLinearVelocity.Y,
            hrp.AssemblyLinearVelocity.Z * 0.5
        )
    end
    last_pos  = hrp.Position
    last_time = now
end)
print("[Xyn] camada 3 — velocity clamp ativo")

-- ============================================================
-- TWEEN MOVEMENT
-- ============================================================
local tweening = false
local function tween_to(pos, duration)
    local char = LP.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local t = Tween:Create(hrp,
        TweenInfo.new(duration or CFG.tween_duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out),
        { CFrame = CFrame.new(pos) })
    tweening = true
    t:Play()
    t:Completed:Wait()
    tweening = false
end

-- ============================================================
-- HELPERS
-- ============================================================
local function find_remote(...)
    local pats = {...}
    for _, obj in ipairs(RS:GetDescendants()) do
        if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
            local n = obj.Name:lower()
            for _, p in ipairs(pats) do
                if n:find(p) then return obj end
            end
        end
    end
end

local function nearest_egg(max_dist)
    local char = LP.Character
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end

    local best, best_d = nil, max_dist or math.huge
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local n = obj.Name:lower()
            if n:find("egg") or n:find("brainrot") or n:find("pet") then
                local d = (obj.Position - hrp.Position).Magnitude
                if d < best_d then best, best_d = obj, d end
            end
        end
    end
    return best, best_d
end

-- ============================================================
-- AUTO STEAL — tween + remote
-- ============================================================
spawn(function()
    while task.wait(CFG.steal_delay) do
        if CFG.auto_steal then
            local egg = nearest_egg(CFG.steal_range)
            if egg and not tweening then
                local char = LP.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local target = egg.Position + (egg.Position - hrp.Position).Unit * -4
                    tween_to(target, CFG.tween_duration)
                    task.wait(CFG.tween_duration + 0.1)

                    local rem = find_remote("steal", "grab", "pickup")
                    if rem then
                        pcall(function() rem:FireServer(egg) end)
                        pcall(function() rem:FireServer() end)
                    end
                end
            end
        end
    end
end)

