    ESPBox         = false,
    ESPName        = false,
    ESPSkeleton    = false,
    AimbotEnabled  = false,
    TeamCheck      = true,
    WallCheck      = true,
    ShowFOV        = true,
    FOVSize        = 350,
    Smoothness     = 0.15, -- O Lerp máximo seguro fica em ~0.85
}

local MAX_ESP_DISTANCE = 1000
local ACCENT_COLOR = Color3.fromRGB(138, 43, 226) -- Roxo Xyn
local BG_COLOR = Color3.fromRGB(18, 18, 22)
local ROW_COLOR = Color3.fromRGB(28, 28, 35)

-- ----------------- Helpers -----------------
local function makeDrawing(className, props)
    local d = Drawing.new(className)
    for k, v in pairs(props or {}) do d[k] = v end
    return d
end

local function distColor(dist, maxDist)
    local t = math.clamp(dist / maxDist, 0, 1)
    return Color3.fromHSV(0.33 * (1 - t), 1, 1)
end

local SKELETON_CONNECTIONS = {
    {"Head", "UpperTorso"}, {"UpperTorso", "LowerTorso"},
    {"UpperTorso", "LeftUpperArm"}, {"UpperTorso", "RightUpperArm"},
    {"LeftUpperArm", "LeftLowerArm"}, {"RightUpperArm", "RightLowerArm"},
    {"LeftLowerArm", "LeftHand"}, {"RightLowerArm", "RightHand"},
    {"LowerTorso", "LeftUpperLeg"}, {"LowerTorso", "RightUpperLeg"},
    {"LeftUpperLeg", "LeftLowerLeg"}, {"RightUpperLeg", "RightLowerLeg"},
    {"LeftLowerLeg", "LeftFoot"}, {"RightLowerLeg", "RightFoot"}
}

