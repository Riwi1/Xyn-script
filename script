-- ----- ABA: TELEPORTE -----
local TpTab = Window:CreateTab("Teleporte", 4483362458)

local islandNames = {}
for name, _ in pairs(ISLANDS[CURRENT_SEA] or {}) do
    table.insert(islandNames, name)
end
table.sort(islandNames)

TpTab:CreateDropdown({
    Name = "Selecionar Ilha",
    Options = islandNames,
    CurrentOption = {islandNames[1] or "N/A"},
    Flag = "IslandSelect",
    Callback = function(opt) N.SelectedIsland = opt[1] end
})

TpTab:CreateButton({
    Name = "Teleportar (Tween)",
    Callback = function()
        local name = N.SelectedIsland
        if name and ISLANDS[CURRENT_SEA][name] then
            tweenTo(ISLANDS[CURRENT_SEA][name], 0.5)
            Rayfield:Notify({
                Title = "Teleporte",
                Content = "Indo para " .. name,
                Duration = 2
            })
        end
    end
})

