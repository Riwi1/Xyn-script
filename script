-- ============================================================
-- UTIL — encontrar remotes por nome parcial
-- ============================================================
local function find_remote(partial)
    partial = partial:lower()
    for _, obj in ipairs(RS:GetDescendants()) do
        if (obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction")) then
            if obj.Name:lower():find(partial) then
                return obj
            end
        end
    end
    return nil
end

local function dump_remotes()
    print("========== XYN REMOTE DUMP ==========")
    for _, obj in ipairs(RS:GetDescendants()) do
        if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
            print(string.format("[%s] %s", obj.ClassName, obj:GetFullName()))
        end
    end
    print("=====================================")
end

-- ============================================================
-- CORE — Auto Steal
-- ============================================================
local function get_closest_target(max_dist)
    local root = Local.Character and Local.Character:FindFirstChild("HumanoidRootPart")
    if not root then return nil, math.huge end
    local closest, closest_dist = nil, max_dist or math.huge
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Anchored then
            local name = obj.Name:lower()
            if name:find("egg") or name:find("brainrot") or name:find("pet") then
                local d = (obj.Position - root.Position).Magnitude
                if d < closest_dist then
                    closest, closest_dist = obj, d
                end
            end
        end
    end
    return closest, closest_dist
end

local function fire_steal(remote, target)
    if not remote then return end
    local root = Local.Character and Local.Character:FindFirstChild("HumanoidRootPart")
    if not root then return end
    pcall(function()
        remote:FireServer(target)
    end)
    pcall(function()
        remote:FireServer()
    end)
end

spawn(function()
    while task.wait(_G.Xyn.steal_delay) do
        if _G.Xyn.auto_steal then
            local remote = _G.Xyn.selected_remote ~= "" and find_remote(_G.Xyn.selected_remote)
                            or find_remote("steal")
                            or find_remote("grab")
            local target = get_closest_target(_G.Xyn.steal_range)
            if remote then
                fire_steal(remote, target)
            end
        end
    end
end)

