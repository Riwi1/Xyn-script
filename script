-- ============================================================
-- QUEST LOGIC
-- ============================================================
local function getQuestEntry()
    local level = getLevel()
    local seaDB = QUEST_DB[CURRENT_SEA]
    if not seaDB then return nil end

    for _, entry in ipairs(seaDB) do
        if level >= entry.minLv and level <= entry.maxLv then
            return entry
        end
    end
    local fallback = nil
    for _, entry in ipairs(seaDB) do
        if level >= entry.minLv then fallback = entry end
    end
    return fallback
end

local function hasActiveQuest()
    local gui = LocalPlayer:FindFirstChild("PlayerGui")
    if not gui then return false end
    local main = gui:FindFirstChild("Main")
    if not main then return false end
    local quest = main:FindFirstChild("Quest")
    if quest and quest.Visible then
        return true
    end
    return false
end

local function acceptQuest(entry)
    if not entry then return false end
    local ok = pcall(function()
        CommF:InvokeServer("StartQuest", entry.quest, entry.levelQuest)
    end)
    if ok then
        N.LastQuestID = entry.quest
        N.LastQuestTime = tick()
    end
    return ok
end

local function abandonQuest()
    pcall(function()
        CommF:InvokeServer("AbandonQuest")
    end)
end

-- ============================================================
-- ATTACK (sem interagir com inventário)
-- ============================================================
local function attack()
    local tool = getTool()
    if tool then
        pcall(function() tool:Activate() end)
    end
end

-- ============================================================
-- FARM LOOP (com prioridade de missão)
-- ============================================================
local function farmStep()
    local entry = getQuestEntry()
    if not entry then
        N.Status = "sem quest para o nível"
        return
    end

    local hrp = getHRP()
    if not hrp then return end

    -- ========================================================
    -- PASSO 1: VERIFICAR SE HÁ QUEST ATIVA
    -- ========================================================
    local hasQuest = hasActiveQuest()

    if not hasQuest then
        -- Sem missão: ir ao NPC e aceitar
        N.Status = "indo pro NPC: " .. entry.quest

        -- Se a distância for muito grande, usar requestEntrance
        local distToNPC = (entry.CFrameQ.Position - hrp.Position).Magnitude
        if distToNPC > 3000 then
            requestEntrance(entry.CFrameQ.Position)
            task.wait(0.5)
        else
            tweenTo(entry.CFrameQ.Position + Vector3.new(0, 5, 0), 0.4)
            task.wait(0.2)
        end

        -- Verifica se chegou perto o suficiente para aceitar
        local newDist = (entry.CFrameQ.Position - hrp.Position).Magnitude
        if newDist <= 15 then
            N.Status = "aceitando quest: " .. entry.quest
            acceptQuest(entry)
            task.wait(0.8)
        end
        return
    end

    -- ========================================================
    -- PASSO 2: QUEST ATIVA -> IR PARA O MOB E ATACAR
    -- ========================================================
    N.Status = "indo para o mob: " .. entry.target

    -- Se a distância for muito grande, usar requestEntrance
    local distToMob = (entry.CFrameMon.Position - hrp.Position).Magnitude
    if distToMob > 3000 then
        requestEntrance(entry.CFrameMon.Position)
        task.wait(0.5)
    else
        tweenTo(entry.CFrameMon.Position + Vector3.new(0, 5, 0), 0.12)
    end

    -- Ataca o mob mais próximo do tipo correto
    local enemies = workspace:FindFirstChild("Enemies")
    if enemies then
        local best, bestDist = nil, math.huge
        for _, mob in pairs(enemies:GetChildren()) do
            if mob:IsA("Model") and mob.Name:find(entry.target)
               and mob:FindFirstChild("HumanoidRootPart")
               and mob:FindFirstChildOfClass("Humanoid") then
                local hum = mob:FindFirstChildOfClass("Humanoid")
                if hum.Health > 0 then
                    local d = (mob.HumanoidRootPart.Position - hrp.Position).Magnitude
                    if d < bestDist then
                        best, bestDist = mob, d
                    end
                end
            end
        end

        if best then
            N.Status = "atacando: " .. entry.target .. " (" .. math.floor(bestDist) .. " studs)"
            tweenTo(best.HumanoidRootPart.Position + Vector3.new(0, 5, 0), 0.1)
            attack()
            task.wait(N.AttackDelay)

            -- Kill count
            local hum = best:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health <= 0 then
                N.KillCount = N.KillCount + 1
            end
        else
            N.Status = "procurando: " .. entry.target
            task.wait(0.2)
        end
    end
end

-- ============================================================
-- ESP (BillboardGui)
-- ============================================================
local espFolder = Instance.new("Folder")
espFolder.Name = "Nexus_ESP"
espFolder.Parent = workspace

local function makeESP(part, text, color)
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "ESP"
    billboard.Adornee = part
    billboard.Size = UDim2.new(0, 200, 0, 40)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = espFolder

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = color
    label.TextStrokeTransparency = 0
    label.TextScaled = true
    label.Font = Enum.Font.SourceSansBold
    label.Parent = billboard
end

local function updateESP()
    espFolder:ClearAllChildren()

    if N.EspFruit then
        for _, obj in pairs(workspace:GetDescendants()) do
            if obj:IsA("Tool") and obj:FindFirstChild("Handle")
               and (obj.Name:find("Fruit") or obj.Name == "Fruit") then
                makeESP(obj.Handle, obj.Name, Color3.fromRGB(50, 255, 50))
            end
        end
    end

    if N.EspChest then
        for _, obj in pairs(workspace:GetDescendants()) do
            if obj.Name == "Chest" and obj:IsA("MeshPart") then
                makeESP(obj, "Bau", Color3.fromRGB(255, 215, 0))
            end
        end
    end

    if N.EspPlayer then
        for _, plr in pairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character then
                local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    makeESP(hrp, plr.Name, Color3.fromRGB(255, 50, 50))
                end
            end
        end
    end

    if N.EspNPC then
        for _, obj in pairs(workspace:GetChildren()) do
            if obj:IsA("Model") and obj:FindFirstChild("Humanoid")
               and obj:FindFirstChild("HumanoidRootPart") then
                makeESP(obj.HumanoidRootPart, obj.Name, Color3.fromRGB(100, 200, 255))
            end
        end
    end
end

