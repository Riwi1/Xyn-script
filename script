local espData = {}
local fovCircle = makeDrawing("Circle", {
    Visible = false, Thickness = 1.5, Filled = false, 
    Color = ACCENT_COLOR, Transparency = 0.5, NumSides = 40
})

-- NOVO: Variável de Target Lock (evita ficar trocando de alvo e causar lag)
local lockedTarget = nil

local function isVisible(targetPart)
    local origin = Camera.CFrame.Position
    local direction = (targetPart.Position - origin)
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    raycastParams.FilterDescendantsInstances = {LocalPlayer.Character, Camera}
    local result = Workspace:Raycast(origin, direction, raycastParams)
    if result then
        if result.Instance:IsDescendantOf(targetPart.Parent) then return true end
        return false
    end
    return true
end

local function clearEsp(player)
    if espData[player] then
        for _, obj in pairs(espData[player]) do
            if typeof(obj) == "table" and obj.Remove then obj:Remove() 
            elseif typeof(obj) == "Instance" then obj:Destroy() end
        end
        espData[player] = nil
    end
end

local function ensureEsp(player)
    if espData[player] then return end
    local d = {}
    if Config.ESPBox then d.box = makeDrawing("Square", { Visible = false, Thickness = 1 }) end
    if Config.ESPName then 
        d.name = makeDrawing("Text", { Visible = false, Size = 14, Center = true, Outline = true })
        d.dist = makeDrawing("Text", { Visible = false, Size = 12, Center = true, Outline = true, Color = Color3.fromRGB(200, 200, 200) })
    end
    if Config.ESPSkeleton then
        d.skel = {}
        for i = 1, #SKELETON_CONNECTIONS do
            d.skel[i] = makeDrawing("Line", { Visible = false, Thickness = 1 })
        end
    end
    espData[player] = d
end

local function updateEsp()
    if not Config.ESPEnabled then
        for p, _ in pairs(espData) do clearEsp(p) end
        return
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local isTeammate = (Config.TeamCheck and player.Team == LocalPlayer.Team)
            
            ensureEsp(player)
            local d = espData[player]
            local char = player.Character
            local hrp = char.HumanoidRootPart
            local head = char:FindFirstChild("Head")

            local dist = (Camera.CFrame.Position - hrp.Position).Magnitude

            if isTeammate or dist > MAX_ESP_DISTANCE or not head then
                if d.box then d.box.Visible = false end
                if d.name then d.name.Visible = false end
                if d.dist then d.dist.Visible = false end
                if d.skel then for _, l in pairs(d.skel) do l.Visible = false end end
                continue
            end

            local topPos, onScreenTop = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
            local botPos, onScreenBot = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))

            if onScreenTop and onScreenBot and topPos.Z > 0 then
                local height = math.abs(topPos.Y - botPos.Y)
                local width = height * 0.6
                
                if d.box then
                    d.box.Visible = Config.ESPBox
                    d.box.Size = Vector2.new(width, height)
                    d.box.Position = Vector2.new(topPos.X - width/2, topPos.Y)
                    if Config.WallCheck then
                        d.box.Color = isVisible(head) and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 50, 50)
                    else
                        d.box.Color = distColor(dist, MAX_ESP_DISTANCE)
                    end
                end

                if d.name and d.dist then
                    d.name.Visible = Config.ESPName
                    d.name.Text = player.Name
                    d.name.Position = Vector2.new(topPos.X, topPos.Y - 20)
                    d.name.Color = Color3.fromRGB(255, 255, 255)

                    d.dist.Visible = Config.ESPName
                    d.dist.Text = math.floor(dist) .. "m"
                    d.dist.Position = Vector2.new(topPos.X, botPos.Y + 5)
                end

                if d.skel then
                    for i, conn in ipairs(SKELETON_CONNECTIONS) do
                        local p1 = char:FindFirstChild(conn[1])
                        local p2 = char:FindFirstChild(conn[2])
                        local line = d.skel[i]
                        if p1 and p2 and Config.ESPSkeleton then
                            local s1, on1 = Camera:WorldToViewportPoint(p1.Position)
                            local s2, on2 = Camera:WorldToViewportPoint(p2.Position)
                            if on1 and on2 and s1.Z > 0 then
                                line.Visible = true
                                line.From = Vector2.new(s1.X, s1.Y)
                                line.To = Vector2.new(s2.X, s2.Y)
                                line.Color = distColor(dist, MAX_ESP_DISTANCE)
                            else
                                line.Visible = false
                            end
                        else
                            line.Visible = false
                        end
                    end
                end
            else
                if d.box then d.box.Visible = false end
                if d.name then d.name.Visible = false end
                if d.dist then d.dist.Visible = false end
                if d.skel then for _, l in pairs(d.skel) do l.Visible = false end end
            end
        end
    end
end

local function getClosestPlayer()
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    
    -- TARGET LOCK: Verifica se o alvo atual ainda é válido
    if lockedTarget and lockedTarget.Parent then
        local enemyChar = lockedTarget.Parent
        local enemyHum = enemyChar:FindFirstChild("Humanoid")
        
        if enemyHum and enemyHum.Health > 0 then
            if not (Config.TeamCheck and Players:GetPlayerFromCharacter(enemyChar) and Players:GetPlayerFromCharacter(enemyChar).Team == LocalPlayer.Team) then
                local screenPos, onScreen = Camera:WorldToViewportPoint(lockedTarget.Position)
                if onScreen and screenPos.Z > 0 then
                    local dist = (center - Vector2.new(screenPos.X, screenPos.Y)).Magnitude
                    if dist < Config.FOVSize then
                        return lockedTarget -- Mantém o alvo travado
                    end
                end
            end
        end
        lockedTarget = nil -- Se saiu do FOV ou morreu, destrava
    end

    -- Se não tem alvo travado, procura o mais próximo
    local closest = nil
    local shortestDist = Config.FOVSize

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Head") then
            if Config.TeamCheck and player.Team == LocalPlayer.Team then continue end
            
            local head = player.Character.Head
            if Config.WallCheck and not isVisible(head) then continue end
            
            local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
            if onScreen and screenPos.Z > 0 then
                local dist = (center - Vector2.new(screenPos.X, screenPos.Y)).Magnitude
                if dist < shortestDist then
                    shortestDist = dist
                    closest = head
                end
            end
        end
    end
    
    lockedTarget = closest -- Salva o novo alvo
    return closest
end

-- Main Loop
RunService.RenderStepped:Connect(function()
    updateEsp()

    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    
    fovCircle.Visible = Config.AimbotEnabled and Config.ShowFOV
    if fovCircle.Visible then
        fovCircle.Position = center
        fovCircle.Radius = Config.FOVSize
    end

    if Config.AimbotEnabled then
        local target = getClosestPlayer()
        if target then
            local currentCF = Camera.CFrame
            -- O ponto exato do alvo
            local targetPos = target.Position
            
            -- Correção de Lag: Limitamos o máximo de smoothness interno pra 0.85
            -- Se o cara colocar no máximo, não vai travar a tela.
            local safeSmooth = math.clamp(Config.Smoothness, 0.02, 0.85)
            
            local targetCF = CFrame.new(currentCF.Position, targetPos)
            Camera.CFrame = currentCF:Lerp(targetCF, safeSmooth)
        end
    end
end)

-- Cleanup
LocalPlayer.CharacterAdded:Connect(function()
    for p, _ in pairs(espData) do clearEsp(p) end
    espData = {}
    lockedTarget = nil
end)

print("[Xyn Hub] Carregado. Design atualizado e Target Lock ativado.")
