-- Slider genérico (preto & branco)
local function makeSlider(row: {Value: TextLabel}, min: number, max: number, step: number, onChange: (number)->nil): Frame
	local slider = Instance.new("Frame")
	slider.Name        = "Slider"
	slider.Size        = UDim2.new(1, 0, 0, 20)
	slider.Position    = UDim2.new(0, 0, 0, 14)
	slider.BackgroundTransparency = 1
	slider.Parent      = row.Parent

	-- trilha
	local track = Instance.new("Frame")
	track.Name        = "Track"
	track.Size        = UDim2.new(1, 0, 0, 4)
	track.Position    = UDim2.new(0, 0, 0.5, -2)
	track.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
	track.Parent      = slider

	local trackCorner = Instance.new("UICorner")
	trackCorner.CornerRadius = UDim.new(0, 2)
	trackCorner.Parent = track

	-- preenchimento (fill)
	local fill = Instance.new("Frame")
	fill.Name        = "Fill"
	fill.Size        = UDim2.new(0.5, 0, 1, 0)
	fill.Position    = UDim2.new(0, 0, 0, 0)
	fill.BackgroundColor3 = Config.AccentColor
	fill.Parent      = track

	local fillCorner = Instance.new("UICorner")
	fillCorner.CornerRadius = UDim.new(0, 2)
	fillCorner.Parent = fill

	-- botão do slider (thumb)
	local thumb = Instance.new("TextButton")
	thumb.Name        = "Thumb"
	thumb.Size        = UDim2.new(0, 16, 0, 16)
	thumb.Position    = UDim2.new(0.5, -8, 0.5, -8)
	thumb.BackgroundColor3 = Config.AccentColor
	thumb.Text        = ""
	thumb.BorderSizePixel = 0
	thumb.Parent      = slider

	local thumbCorner = Instance.new("UICorner")
	thumbCorner.CornerRadius = UDim.new(0, 8)
	thumbCorner.Parent = thumb

	local dragging = false

	local function updateFromMouse(mousePos: Vector2)
		local rel = math.clamp((mousePos.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
		local raw = min + (max - min) * rel
		local stepped = math.floor(raw / step + 0.5) * step
		local rounded = math.round(stepped * 100) / 100
		onChange(rounded)
		updateUI(rel)
	end

	local function updateUI(rel: number)
		fill.Size = UDim2.new(rel, 0, 1, 0)
		thumb.Position = UDim2.new(math.clamp(rel - 0.5, -0.5, 0.5), -8, 0.5, -8)
	end

	-- inicializa
	local initialRel = (Config.Smoothness - 0) / (1 - 0) -- slider de suavidade usa 0..1 como exemplo
	updateUI(math.clamp(initialRel, 0, 1))

	thumb.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
		end
	end)
	thumb.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
	UserInputService.InputChanged:Connect(function(input, gp)
		if dragging and (input.KeyCode == nil or input.UserInputType == Enum.UserInputType.MouseMovement) then
			updateFromMouse(gp)
		end
	end)

	return slider
end

