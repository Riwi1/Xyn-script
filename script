    holder.Size = UDim2.new(1, 0, 0, 32)
    holder.BackgroundColor3 = Color3.fromRGB(25, 20, 35)
    holder.LayoutOrder = ui_order
    ui_order = ui_order + 1
    Instance.new("UICorner", holder).CornerRadius = UDim.new(0, 6)
    
    local lbl = Instance.new("TextLabel", holder)
    lbl.Size = UDim2.new(1, -50, 1, 0)
    lbl.Position = UDim2.new(0, 10, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = text
    lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
    lbl.Font = Enum.Font.Gotham
    lbl.TextSize = 12
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    
    local btn = Instance.new("TextButton", holder)
    btn.Size = UDim2.new(0, 36, 0, 18)
    btn.Position = UDim2.new(1, -46, 0.5, -9)
    btn.BackgroundColor3 = config[key] and Color3.fromRGB(100, 50, 180) or Color3.fromRGB(40, 40, 50)
    btn.Text = ""
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 9)
    
    local dot = Instance.new("Frame", btn)
    dot.Size = UDim2.new(0, 14, 0, 14)
    dot.Position = config[key] and UDim2.new(1, -16, 0, 2) or UDim2.new(0, 2, 0, 2)
    dot.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    Instance.new("UICorner", dot).CornerRadius = UDim.new(0, 7)
    
    btn.MouseButton1Click:Connect(function()
        config[key] = not config[key]
        TweenService:Create(btn, TweenInfo.new(0.15), {BackgroundColor3 = config[key] and Color3.fromRGB(100, 50, 180) or Color3.fromRGB(40, 40, 50)}):Play()
        TweenService:Create(dot, TweenInfo.new(0.15), {Position = config[key] and UDim2.new(1, -16, 0, 2) or UDim2.new(0, 2, 0, 2)}):Play()
    end)
end

local function add_slider(page, text, key, min, max, decimals)
    local holder = Instance.new("Frame", page)
    holder.Size = UDim2.new(1, 0, 0, 48)
    holder.BackgroundColor3 = Color3.fromRGB(25, 20, 35)
    holder.LayoutOrder = ui_order
    ui_order = ui_order + 1
    Instance.new("UICorner", holder).CornerRadius = UDim.new(0, 6)
    
    local lbl = Instance.new("TextLabel", holder)
    lbl.Size = UDim2.new(1, -20, 0, 16)
    lbl.Position = UDim2.new(0, 10, 0, 4)
    lbl.BackgroundTransparency = 1
    lbl.Text = text .. ": " .. tostring(config[key])
    lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
    lbl.Font = Enum.Font.Gotham
    lbl.TextSize = 12
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    
    local track = Instance.new("Frame", holder)
    track.Size = UDim2.new(1, -20, 0, 4)
    track.Position = UDim2.new(0, 10, 0, 32)
    track.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
    Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)
    
    local fill = Instance.new("Frame", track)
    fill.Size = UDim2.new((config[key] - min) / (max - min), 0, 1, 0)
    fill.BackgroundColor3 = Color3.fromRGB(150, 90, 255)
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)
    
    local dragging = false
    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local pct = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
            local val = min + pct * (max - min)
            if decimals then val = math.floor(val * 10^decimals) / 10^decimals else val = math.floor(val) end
            config[key] = val
            fill.Size = UDim2.new(pct, 0, 1, 0)
            lbl.Text = text .. ": " .. tostring(val)
        end
    end)
end

