-- Toggle (ativar/desativar) com animação de cor
local function setToggle(on: boolean)
	AimState.Enabled = on
	local targetColor = on and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(20, 20, 20)
	local targetText  = on and "DESATIVAR" or "ATIVAR"

	TweenService:Create(toggleBtn, TweenInfo.new(0.25), {
		BackgroundColor3 = targetColor,
		TextColor3       = on and Color3.fromRGB(0, 0, 0) or Config.AccentColor,
	})
	task.delay(0.01, function() toggleBtn.Text = targetText end)

	-- atualiza ponto de status
	statusDot.BackgroundColor3 = on and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(120, 120, 120)
	StatusText.Text = "AGUARDANDO"
end

toggleBtn.MouseButtonClicked:Connect(function()
	setToggle(not AimState.Enabled)
end)

