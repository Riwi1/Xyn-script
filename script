-- ===================== helpers =====================
local function is_alive(plr)
    local char = plr.Character
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    return hum and hum.Health > 0
end

local function get_char(plr)
    return plr.Character
end

local function get_root(plr)
    local char = plr.Character
    if not char then return nil end
    return char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
end

local function get_head(plr)
    local char = plr.Character
    if not char then return nil end
    return char:FindFirstChild("Head")
end

local function same_team(a, b)
    if not a or not b then return false end
    local ta, tb = a.Team, b.Team
    if not ta or not tb then return false end
    return ta == tb
end

local function world_to_screen(pos)
    local sp, on_screen = Camera:WorldToViewportPoint(pos)
    return Vector2.new(sp.X, sp.Y), on_screen and sp.Z > 0
end

local function has_los(target_char)
    if not state.aim_wall_check then return true end
    local origin = Camera.CFrame.Position
    local target_head = target_char:FindFirstChild("Head")
    if not target_head then return false end
    local dir = (target_head.Position - origin)
    local ray_params = RaycastParams.new()
    ray_params.FilterType = Enum.RaycastFilterType.Exclude
    ray_params.FilterDescendantsInstances = { LocalPlayer.Character }
    local result = Workspace:Raycast(origin, dir, ray_params)
    if not result then return true end
    return result.Instance:IsDescendantOf(target_char)
end

-- ===================== drawing =====================
local drawing_objects = {}

local function new_drawing(class, props)
    local ok, obj = pcall(function() return Drawing.new(class) end)
    if not ok or not obj then return nil end
    for k, v in pairs(props) do obj[k] = v end
    obj.Visible = false
    return obj
end

local function release_drawing(obj)
    if obj then pcall(function() obj:Remove() end) end
end

for _, plr in ipairs(Players:GetPlayers()) do
    if plr ~= LocalPlayer then
        drawing_objects[plr] = {
            box    = new_drawing("Square", { Thickness = 1, Color = state.accent, Filled = false }),
            name   = new_drawing("Text",   { Size = 14, Center = true, Outline = true, Color = state.text, Font = 2 }),
            hp_bg  = new_drawing("Square", { Thickness = 0, Color = Color3.fromRGB(30,30,30), Filled = true }),
            hp_bar = new_drawing("Square", { Thickness = 0, Color = Color3.fromRGB(80, 220, 120), Filled = true }),
            dist   = new_drawing("Text",   { Size = 13, Center = true, Outline = true, Color = Color3.fromRGB(200,190,220), Font = 2 }),
        }
    end
end

local function cleanup(plr)
    local d = drawing_objects[plr]
    if d then
        for _, obj in pairs(d) do release_drawing(obj) end
        drawing_objects[plr] = nil
    end
end

