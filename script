-- ---------- Helpers de GUI ----------
local function roundedRect(size, color, parent)
    local s = Instance.new("Frame")
    s.Size = UDim2.new(size.X.Scale, 0, size.Y.Scale, 0)
    s.BackgroundColor3 = color
    s.BorderSizePixel = 0
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.fromPercent(0.12)
    c.Parent = s
    return s
end

local function label(text, pos, size, color, parent, scale)
    local l = Instance.new("Label")
    l.Text = text
    l.Font = Enum.Font.GothamBold
    l.TextColor3 = color or THEME.text
    l.BackgroundTransparency = 1
    l.Size = UDim2.new(size and size.X.Scale or 1, 0, size and size.Y.Scale or 1, 0)
    l.Position = pos
    if scale then l.TextScaled = true end
    l.Parent = parent
    return l
end

local function toggle(on)
    local t = Instance.new("Frame")
    t.BackgroundTransparency = 1
    t.Size = UDim2.new(0.13, 0, 0.06, 0)
    local bg = Instance.new("Frame")
    bg.Size = UDim2.new(1, 0, 1, 0)
    bg.BackgroundColor3 = on and THEME.accent or Color3.fromRGB(55, 60, 75)
    local c = Instance.new("UICorner"); c.CornerRadius = UDim.fromPercent(0.5); c.Parent = bg
    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0.5, 0, 1, 0)
    knob.Position = UDim2.new(on and 0.5 or 0, 0, 0, 0)
    knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    local kc = Instance.new("UICorner"); kc.CornerRadius = UDim.fromPercent(0.5); kc.Parent = knob
    bg.Parent = t; knob.Parent = t
    return t
end

