-- ============================================================
-- BYPASS — camada 3: velocity clamp
-- ============================================================
local last_pos  = Vector3.new(0, 0, 0)
local last_time = tick()

RunS.Heartbeat:Connect(function()
    local char = LP.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local now = tick()
    local dt = now - last_time
    if dt > 0.1 then
        last_pos = hrp.Position
        last_time = now
        return
    end

    local delta = hrp.Position - last_pos
    local horiz_speed = Vector3.new(delta.X, 0, delta.Z).Magnitude / dt
    if horiz_speed > 70 then
        hrp.AssemblyLinearVelocity = Vector3.new(
            hrp.AssemblyLinearVelocity.X * 0.5,
            hrp.AssemblyLinearVelocity.Y,
            hrp.AssemblyLinearVelocity.Z * 0.5
        )
    end

    last_pos = hrp.Position
    last_time = now
end)

-- ============================================================
-- TWEEN — substitui teleporte
-- ============================================================
local tweening = false

local function tween_to(target_pos, duration)
    local char = LP.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local goal = { CFrame = CFrame.new(target_pos) }
    local info = TweenInfo.new(duration or CFG.tween_duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
    local t = Tween:Create(hrp, info, goal)
    tweening = true
    t:Play()
    t:Completed:Wait()
    tweening = false
end

