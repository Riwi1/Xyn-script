local SEGMENTS = 24
local ringSegments = {}

for i = 1, SEGMENTS do
    local angle = (i / SEGMENTS) * math.pi * 2
    local seg = create("Frame", {
        Size = UDim2.new(1, 0, 0, CONFIG.FovThickness),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(
            0.5, math.cos(angle) * CONFIG.FovRadius,
            0.5, math.sin(angle) * CONFIG.FovRadius
        ),
        Rotation = math.deg(angle) + 90,
        BackgroundColor3 = CONFIG.FovColor,
        BackgroundTransparency = CONFIG.FovTransparency,
        BorderSizePixel = 0,
        Parent = FovRing,
    })
    create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = seg })
    table.insert(ringSegments, seg)
end

local function redrawFov()
    local r = CONFIG.FovRadius
    FovRing.Size = UDim2.new(0, r * 2, 0, r * 2)
    for i, seg in ipairs(ringSegments) do
        local angle = (i / SEGMENTS) * math.pi * 2
        seg.Position = UDim2.new(0.5, math.cos(angle) * r, 0.5, math.sin(angle) * r)
        seg.Size = UDim2.new(1, 0, 0, CONFIG.FovThickness)
        seg.BackgroundColor3 = CONFIG.FovColor
        seg.BackgroundTransparency = CONFIG.FovTransparency
    end
    FovGui.Enabled = CONFIG.FovVisible
end

_G._redrawFov = redrawFov
redrawFov()

--=====================================================================
-- ALVO (detecção dentro do FOV)
--=====================================================================
local function getTargetInFov()
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local closest, closestDist = nil, CONFIG.FovRadius

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer then continue end
        if #AuthorizedTargets > 0 and not table.find(AuthorizedTargets, plr.Name) then continue end

        local char = plr.Character
        if not char then continue end

        local head = char:FindFirstChild("Head")
        local hrp  = char:FindFirstChild("HumanoidRootPart")
        local hum  = char:FindFirstChildOfClass("Humanoid")
        if not (head and hrp and hum and hum.Health > 0) then continue end

        if CONFIG.TeamCheck and plr.Team == LocalPlayer.Team then continue end
        if (hrp.Position - Camera.CFrame.Position).Magnitude > CONFIG.MaxDistance then continue end

        local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
        if not onScreen then continue end

        local dist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
        if dist < closestDist then
            closestDist = dist
            closest = head
        end
    end
    return closest
end

--=====================================================================
-- AIMBOT SUAVE
--=====================================================================
RunService.RenderStepped:Connect(function(dt)
    if not CONFIG.AimbotEnabled then return end

    local target = getTargetInFov()
    if not target then return end

    local camPos = Camera.CFrame.Position
    local desired = CFrame.new(camPos, target.Position)

    local alpha = 1 - math.pow(
        1 - math.clamp(1 - CONFIG.Smoothness, 0.05, 0.95),
        dt * 60
    )
    Camera.CFrame = Camera.CFrame:Lerp(desired, alpha)
end)

