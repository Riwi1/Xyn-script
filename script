-- // ESP SYSTEM //
local function apply_esp(player)
    if player == LocalPlayer then return end
    
    local char = player.Character
    if not char then return end

    local head = char:FindFirstChild("Head")
    if not head then return end

    local esp = Instance.new("BillboardGui")
    esp.Name = player.Name
    esp.Adornee = head
    esp.Size = UDim2.new(0, 100, 0, 50)
    esp.StudsOffset = Vector3.new(0, 1.2, 0)
    esp.AlwaysOnTop = true
    esp.Parent = esp_folder

    local box = Instance.new("Frame")
    box.Size = UDim2.new(1, 0, 1, 0)
    box.BackgroundTransparency = 1
    box.Parent = esp
    
    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(150, 90, 255)
    stroke.Thickness = 1
    stroke.Parent = box

    local name_lbl = Instance.new("TextLabel")
    name_lbl.Name = "NameLbl"
    name_lbl.Size = UDim2.new(1, 0, 0.5, 0)
    name_lbl.Position = UDim2.new(0, 0, -0.3, 0)
    name_lbl.BackgroundTransparency = 1
    name_lbl.Text = player.Name
    name_lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
    name_lbl.TextStrokeTransparency = 0
    name_lbl.TextSize = 14
    name_lbl.Font = Enum.Font.GothamBold
    name_lbl.Parent = esp

    local dist_lbl = Instance.new("TextLabel")
    dist_lbl.Name = "DistLbl"
    dist_lbl.Size = UDim2.new(1, 0, 0.5, 0)
    dist_lbl.Position = UDim2.new(0, 0, 0.9, 0)
    dist_lbl.BackgroundTransparency = 1
    dist_lbl.Text = "0m"
    dist_lbl.TextColor3 = Color3.fromRGB(200, 200, 200)
    dist_lbl.TextStrokeTransparency = 0
    dist_lbl.TextSize = 12
    dist_lbl.Font = Enum.Font.Gotham
    dist_lbl.Parent = esp
end

local function update_esp()
    if not config.esp then
        esp_folder.Parent = nil
        return
    else
        esp_folder.Parent = game:GetService("CoreGui")
    end

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local is_team = player.Team == LocalPlayer.Team and player.Team ~= nil
            local esp = esp_folder:FindFirstChild(player.Name)
            
            if config.esp_team_check and is_team then
                if esp then esp.Enabled = false end
            else
                if not esp then
                    apply_esp(player)
                else
                    esp.Enabled = true
                    local root = player.Character:FindFirstChild("HumanoidRootPart")
                    local dist_lbl = esp:FindFirstChild("DistLbl")
                    if root and dist_lbl then
                        local d = math.floor((root.Position - Camera.CFrame.Position).Magnitude)
                        dist_lbl.Text = tostring(d) .. "m"
                    end
                end
            end
        end
    end
end

-- // AIMBOT SYSTEM //
local function get_closest_target()
    local closest = nil
    local shortest_dist = config.fov
    local center = Camera.ViewportSize / 2

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local is_team = player.Team == LocalPlayer.Team and player.Team ~= nil
            local head = player.Character:FindFirstChild("Head")
            local hum = player.Character:FindFirstChildOfClass("Humanoid")
            
            if head and hum and hum.Health > 0 and not (config.aim_team_check and is_team) then
                local screen_pos, on_screen = Camera:WorldToViewportPoint(head.Position)
                if on_screen and screen_pos.Z > 0 then
                    local dist = (Vector2.new(screen_pos.X, screen_pos.Y) - center).Magnitude
                    if dist < shortest_dist then
                        shortest_dist = dist
                        closest = head
                    end
                end
            end
        end
    end
    return closest
end

-- Override do Camera CFrame (Prioridade máxima para ignorar o lock do jogo)
RunService:BindToRenderStep("XynAimbot", Enum.RenderPriority.Camera.Value + 1, function()
    if fov_circle then
        if config.aimbot then
            fov_circle.Position = Camera.ViewportSize / 2
            fov_circle.Radius = config.fov
            fov_circle.Visible = true
        else
            fov_circle.Visible = false
        end
    end

    if config.aimbot and aim_held then
        local target = get_closest_target()
        if target then
            local goal = CFrame.new(Camera.CFrame.Position, target.Position)
            Camera.CFrame = Camera.CFrame:Lerp(goal, config.aim_smooth)
        end
    end
end)

-- Loop normal para o ESP
RunService.RenderStepped:Connect(function()
    update_esp()
end)

-- // INPUTS //
UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.UserInputType == Enum.UserInputType.MouseButton2 then aim_held = true end
    if input.KeyCode == Enum.KeyCode.RightShift then
        if gui then gui.Enabled = not gui.Enabled end
    end
end)

UserInputService.InputEnded:Connect(function(input, gp)
    if input.UserInputType == Enum.UserInputType.MouseButton2 then aim_held = false end
end)

