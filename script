-- ===================== ESP loop =====================
local function update_esp()
    for plr, d in pairs(drawing_objects) do
        local show = state.esp_enabled and plr.Parent and is_alive(plr)
        if show and state.esp_team_check and same_team(plr, LocalPlayer) then show = false end

        if not show then
            for _, obj in pairs(d) do if obj then obj.Visible = false end end
            continue
        end

        local head = get_head(plr)
        local root = get_root(plr)
        if not head or not root then
            for _, obj in pairs(d) do if obj then obj.Visible = false end end
            continue
        end

        local hrp_pos = root.Position
        local head_pos = head.Position + Vector3.new(0, 1.2, 0)
        local foot_pos = hrp_pos - Vector3.new(0, 2.5, 0)

        local top, top_on = world_to_screen(head_pos)
        local bottom, bottom_on = world_to_screen(foot_pos)
        if not (top_on or bottom_on) then
            for _, obj in pairs(d) do if obj then obj.Visible = false end end
            continue
        end

        local height = math.abs(bottom.Y - top.Y)
        local width = height * 0.55
        local x = math.min(top.X, bottom.X) - width / 2
        local y = math.min(top.Y, bottom.Y)

        -- box
        if state.esp_box and d.box then
            d.box.Size = Vector2.new(width, height)
            d.box.Position = Vector2.new(x, y)
            d.box.Color = state.accent
            d.box.Visible = true
        elseif d.box then d.box.Visible = false end

        -- hp
        local hum = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
        if state.esp_health and hum and d.hp_bg and d.hp_bar then
            local pct = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
            local bar_h = height * pct
            d.hp_bg.Size = Vector2.new(3, height)
            d.hp_bg.Position = Vector2.new(x - 6, y)
            d.hp_bar.Size = Vector2.new(3, bar_h)
            d.hp_bar.Position = Vector2.new(x - 6, y + (height - bar_h))
            d.hp_bg.Visible = true
            d.hp_bar.Visible = true
        else
            if d.hp_bg then d.hp_bg.Visible = false end
            if d.hp_bar then d.hp_bar.Visible = false end
        end

        -- name
        if state.esp_name and d.name then
            d.name.Text = plr.Name
            d.name.Position = Vector2.new(x + width / 2, y - 16)
            d.name.Visible = true
        elseif d.name then d.name.Visible = false end

        -- distance
        if state.esp_distance and d.dist then
            local dist = (hrp_pos - Camera.CFrame.Position).Magnitude
            d.dist.Text = string.format("%dm", math.floor(dist))
            d.dist.Position = Vector2.new(x + width / 2, y + height + 4)
            d.dist.Visible = true
        elseif d.dist then d.dist.Visible = false end
    end
end

