local function notify(title, text, duration)
    if not notifHolder then return end
    duration = duration or 3
    local f = make("Frame", {
        Size = UDim2.new(1, 0, 0, 56),
        BackgroundColor3 = C.panel2,
        BackgroundTransparency = 1,
        Parent = notifHolder,
    })
    corner(f, 8)
    local s = stroke(f, C.accent, 1)
    s.Transparency = 1
    local accent = make("Frame", {
        Size = UDim2.new(0, 3, 1, -16),
        Position = UDim2.new(0, 8, 0, 8),
        BackgroundColor3 = C.accent,
        BorderSizePixel = 0,
        Parent = f,
    })
    corner(accent, 2)
    local t1 = make("TextLabel", {
        Text = title, Font = FONT, TextSize = 14,
        TextColor3 = C.text, BackgroundTransparency = 1,
        Position = UDim2.new(0, 20, 0, 8),
        Size = UDim2.new(1, -28, 0, 18),
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = f,
    })
    local t2 = make("TextLabel", {
        Text = text or "", Font = FONT, TextSize = 12,
        TextColor3 = C.sub, BackgroundTransparency = 1,
        Position = UDim2.new(0, 20, 0, 28),
        Size = UDim2.new(1, -28, 0, 18),
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = f,
    })
    TweenService:Create(f, TweenInfo.new(0.25), {BackgroundTransparency = 0}):Play()
    TweenService:Create(s, TweenInfo.new(0.25), {Transparency = 0}):Play()
    task.delay(duration, function()
        TweenService:Create(f, TweenInfo.new(0.3), {BackgroundTransparency = 1}):Play()
        TweenService:Create(s, TweenInfo.new(0.3), {Transparency = 1}):Play()
        task.wait(0.3)
        f:Destroy()
    end)
end

