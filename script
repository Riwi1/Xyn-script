-- LOOP PRINCIPAL
-- ============================================================

task.spawn(function()
    while task.wait(0.1) do
        pcall(function()
            if S.autoFarm then autoFarmLevel() end
            if S.autoChest then autoCollectChest() end
            if S.autoFruit then autoCollectFruit() end
            if S.killAura then killAura() end
            if S.espPlayer or S.espFruit or S.espChest or S.espNPC then
                updateESP()
            end
        end)
    end
end)

-- ============================================================
-- NOCLIP / SPEED / JUMP
-- ============================================================

RunService.Stepped:Connect(function()
    if S.noclip then
        local char = getChar()
        if char then
            for _, part in pairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
        end
    end

    if S.speedHack then
        local hum = getHum()
        if hum then
            hum.WalkSpeed = S.speedValue
        end
    end

    if S.jumpPower then
        local hum = getHum()
        if hum then
            hum.UseJumpPower = true
            hum.JumpPower = S.jumpValue
        end
    end
end)

