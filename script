    while task.wait(0.1) do
        if not N.Enabled then
            N.Status = "parado"
            continue
        end
        local ok, err = pcall(farmStep)
        if not ok then
            warn("[Nexus AF]", err)
            N.Status = "erro: " .. tostring(err)
        end
    end
end)

