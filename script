-- normaliza nome pra match
local function normalize(s)
    return s:lower():gsub("%s+", " "):gsub(" egg", ""):gsub("_", " ")
end

-- retorna valor do ovo pelo nome (match parcial)
local function egg_value(name)
    local n = normalize(name)
    -- match exato primeiro
    if EGG_VALUES[n] then return EGG_VALUES[n] end
    -- match parcial — pega o maior valor que casa
    local best = 0
    for key, val in pairs(EGG_VALUES) do
        if n:find(key, 1, true) and val > best then
            best = val
        end
    end
    return best
end

