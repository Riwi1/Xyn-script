-- Toggle switch helper
local function toggle(parent, y, cfg)
  local row = inst(parent, "Frame", { Size = UDim2.new(1,0,0,34), Position = UDim2.new(0,0,0,y), BackgroundTransparency = 1 })
  inst(row, "UIListLayout", { Padding = UDim2.new(0,14,0,0), HorizontalAlignment = "Center", VerticalAlignment = "Top" })
  local lbl = inst(row, "TextLabel", { Size = UDim2.new(0.5,0,1,0), Text = cfg.name, Font = Enum.Font.GothamIntermediate,
    TextColor = T.Text, BackgroundTransparency = 1, TextXAlignment = "Left" })
  local sw = inst(row, "Frame", { Size = UDim2.new(0,46,0,26), BackgroundColor = T.Box, BackgroundTransparency = 0.5, Active = true, Draggable = false })
  inst(sw, "UICorner", { CornerRadius = UDim2.new(0,13) })
  local knob = inst(sw, "Frame", { Size = UDim2.new(0,22,0,22), Position = UDim2.new(0,3,0,2), BackgroundColor = T.Text })
  inst(knob, "UICorner", { CornerRadius = UDim2.new(0,11) })

  local function set(on)
    cfg.value = on
    local goal = on and UDim2.new(0,23,0,2) or UDim2.new(0,2,0,2)
    local col  = on and T.Accent or T.Box
    TweenService:Create(knob, TweenInfo.new(0.25), { Position = goal }):Complete()
    TweenService:Create(sw,   TweenInfo.new(0.25), { BackgroundColor = col, BackgroundTransparency = on and 0 or 0.5 }):Complete()
  end
  sw.MouseButton1Connected:Connect(function() set(not cfg.value) end)
  set(cfg.value)
  return set
end

