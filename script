  Enabled  = true,
  FOV      = 160,
  LockMode = "Nearest",   -- Nearest | Health | Focus
  HoldAim  = false,       -- segurar tecla (R2) vs sempre ativo
  AimKey   = Enum.UserInputType.MouseButton2,
  ShowFOV  = true,
}

--// Círculo de FOV (drawing, funciona em qualquer executor)
local FOV = drawing.new("Circle")
FOV.NumPoints = 72; FOV.Thickness = 1.5
FOV.Color = T.Accent; FOV.FillColor = Color3.new(0,0,0,0)
FOV.Visible = false

--// Helpers
local function inst(parent, class, p)
  local i = Instance.new(class)
  for k,v in pairs(p or {}) do i[k] = v end
  if parent then i.Parent = parent end
  return i
end
local function hrp(c) return c:FindFirstChild("HumanoidRootPart") end
local function health(plr)
  local h = plr.Character and plr.Character:FindFirstChild("Humanoid") or plr.Character and plr.Character.Humanoid
  return h and h.Health or 0
end

--// Alvo
local function findTarget()
  local best, bv = nil, math.inf
  if C.LockMode == "Focus" then
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    rp.FilterObjects = {Camera}
    local r = workspace:Raycast(Camera.CFrame.Position, Camera.CDirection * 2500, rp)
    if r and r.Instance then
      for _,p in pairs(Players.GetPlayers()) do
        if p ~= LocalPlayer and p.Character and r.Instance:IsDescendantOf(p.Character) then
          local h = hrp(p.Character)
          if h then best, bv = h, 0 end
          break
        end
      end
    end
    return best
  end
  for _,p in pairs(Players.GetPlayers()) do
    if p ~= LocalPlayer and p.Character then
      local h = hrp(p.Character)
      if h then
        local d = (h.Position - Camera.CFrame.Position).Magnitude
        if d <= C.FOV then
          local v = C.LockMode == "Health" and health(p) or d
          if v < bv then best, bv = h, v end
        end
      end
    end
  end
  return best
end

--// Loop de aim
RunService.RenderStepped:Connect(function()
  FOV.Position = Camera.CFrame.Position + Camera.CDirection * 60
  FOV.Radius   = C.FOV
  FOV.Visible  = C.ShowFOV and C.Enabled
  local active = C.Enabled and (not C.HoldAim or UserInput:IsKeyDown(C.AimKey))
  if active then
    local t = findTarget()
    if t then Camera.CFrame = CFrame.new(Camera.CFrame.Position, t.Position + Vector3.new(0,1.5,0)) end
  end
end)

