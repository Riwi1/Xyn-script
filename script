local tweening = false
local function tween_to(pos, duration)
    local char = LP.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local t = Tween:Create(hrp,
        TweenInfo.new(duration or CFG.tween_duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out),
        { CFrame = CFrame.new(pos) })
    tweening = true
    t:Play()
    t:Completed:Wait()
    tweening = false
end

