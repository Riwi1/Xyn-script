-- FOV slider
local function slider(parent, y)
  local row = inst(parent, "Frame", { Size = UDim2.new(1,0,0,56), Position = UDim2.new(0,0,0,y), BackgroundTransparency = 1 })
  local lbl = inst(row, "TextLabel", { Size = UDim2.new(1,0,0,18), Position = UDim2.new(0,0,0,4),
    Text = "FOV  •  "..tostring(C.FOV), Font = Enum.Font.GothamIntermediate, TextColor = T.Dim, BackgroundTransparency = 1 })
  local bg = inst(row, "Frame", { Size = UDim2.new(1,0,0,8), Position = UDim2.new(0,0,0,30), BackgroundColor = T.Box })
  inst(bg, "UICorner", { CornerRadius = UDim2.new(0,4) })
  local fill = inst(bg, "Frame", { Size = UDim2.new(0,0,1,0), BackgroundColor = T.Accent })
  inst(fill, "UICorner", { CornerRadius = UDim2.new(0,4) })
  local knob = inst(bg, "Frame", { Size = UDim2.new(0,14,0,14), Position = UDim2.new(0,-7,0,-3), BackgroundColor = T.Text })
  inst(knob, "UICorner", { CornerRadius = UDim2.new(0,7) })

  local min,max = 20, 400
  local function apply(px)
    local _, w = bg.AbsolutePosition.X, bg.AbsoluteSize.X
    local rel = math.clamp((px - bg.AbsolutePosition.X)/w, 0, 1)
    C.FOV = math.floor(min + rel*(max-min))
    lbl.Text = "FOV  •  "..tostring(C.FOV)
    fill.Size = UDim2.new(rel,0,1,0)
    knob.Position = UDim2.new(rel, -7, 0, -3)
  end
  RunService.Stepped:Connect(function()
    if UserInput:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then apply(UserInput.MousePosition.X) end
  end)
end
