        state[key] = not state[key]
        TweenService:Create(btn, TweenInfo.new(0.15), { BackgroundColor3 = state[key] and state.accent or state.bg_light }):Play()
        TweenService:Create(dot, TweenInfo.new(0.15), { Position = state[key] and UDim2.fromOffset(22, 2) or UDim2.fromOffset(2, 2) }):Play()
        if callback then callback(state[key]) end
    end)
end

local function add_slider(page, label, key, min, max, decimals)
    local holder = Instance.new("Frame")
    holder.Size = UDim2.new(1, 0, 0, 46)
    holder.BackgroundColor3 = state.bg_alt
    holder.BorderSizePixel = 0
    holder.Parent = page
    corner(holder, 6)
    local n = #page:GetChildren()
    holder.Position = UDim2.fromOffset(0, (n - 1) * 52)

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -20, 0, 18)
    lbl.Position = UDim2.fromOffset(12, 4)
    lbl.BackgroundTransparency = 1
    lbl.Text = label .. ": " .. tostring(state[key])
    lbl.Font = Enum.Font.GothamMedium
    lbl.TextSize = 12
    lbl.TextColor3 = state.text
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = holder

    local track = Instance.new("Frame")
    track.Size = UDim2.new(1, -24, 0, 4)
    track.Position = UDim2.new(0, 12, 0, 30)
    track.BackgroundColor3 = state.bg_light
    track.Parent = holder
    corner(track, 2)

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new((state[key] - min) / (max - min), 0, 1, 0)
    fill.BackgroundColor3 = state.accent
    fill.Parent = track
    corner(fill, 2)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.fromOffset(12, 12)
    knob.Position = UDim2.new(fill.Size.X.Scale, -6, 0.5, -6)
    knob.BackgroundColor3 = state.text
    knob.Parent = track
    corner(knob, 6)

    local dragging = false
    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local rel = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
            local val = min + rel * (max - min)
            if decimals then val = math.floor(val * 10^decimals) / 10^decimals else val = math.floor(val) end
            state[key] = val
            fill.Size = UDim2.new(rel, 0, 1, 0)
            knob.Position = UDim2.new(rel, -6, 0.5, -6)
            lbl.Text = label .. ": " .. tostring(val)
        end
    end)
end

