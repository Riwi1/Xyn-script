local aim_held = false
local fov_circle = nil
if Drawing then
    fov_circle = Drawing.new("Circle")
    fov_circle.Thickness = 1.5
    fov_circle.Color = state.accent
    fov_circle.Filled = false
    fov_circle.Transparency = 0.8
    fov_circle.NumSides = 64
    fov_circle.Visible = false
end

local function closest_target(fov)
    local center = Camera.ViewportSize / 2
    local best, best_dist = nil, fov
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and is_alive(plr) then
            local char = get_char(plr)
            if not (state.aim_team_check and same_team(plr, LocalPlayer)) then
                local part = char:FindFirstChild(state.aim_part == "Head" and "Head" or "HumanoidRootPart")
                if part then
                    local sp, on = world_to_screen(part.Position)
                    if on then
                        local d = (sp - center).Magnitude
                        if d < best_dist and (not state.aim_visible_only or has_los(char)) then
                            best, best_dist = { plr = plr, part = part }, d
                        end
                    end
                end
            end
        end
    end
    return best
end

RunService.RenderStepped:Connect(function()
    update_esp()

    if fov_circle then
        if state.aim_enabled and state.menu_open or state.aim_enabled then
            fov_circle.Position = Camera.ViewportSize / 2
            fov_circle.Radius = state.aim_fov
            fov_circle.Color = state.accent
            fov_circle.Visible = state.aim_enabled
        else
            fov_circle.Visible = false
        end
    end

    if state.aim_enabled and aim_held then
        local t = closest_target(state.aim_fov)
        if t then
            local part_pos = t.part.Position
            local root = get_root(t.plr)
            if state.aim_prediction > 0 and root then
                part_pos = part_pos + (root.Velocity * state.aim_prediction)
            end
            local goal = CFrame.new(Camera.CFrame.Position, part_pos)
            Camera.CFrame = Camera.CFrame:Lerp(goal, state.aim_smooth)
        end
    end
end)

UserInputService.InputBegan:Connect(function(input, gp)
