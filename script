local Settings = {
    aimbot   = false,
    autoAtk  = false,
    speed    = false,
    noclip   = false,
    xpBoost  = false,
}

local AIM_RANGE   = 120
local AIM_BONE    = "Head"
local SPRINT_AMT  = 35

-- ---------- Busca de alvo ----------
local function findTarget()
    local rootPos = Root and Root.Position
    if not rootPos then return nil end
    local best, bestDist = nil, math.inf
    -- NPCs (inimigos)
    for _, v in pairs(game.Workspace:GetChildren()) do
        local hum = v:FindFirstChildOfClass("Humanoid")
        local rp  = v:FindFirstChild("HumanoidRootPart") or v:FindFirstChild("Torso")
        if hum and rp and v ~= LocalPlayer.Character then
            local d = (rp.Position - rootPos).Magnitude
            if d < AIM_RANGE and d < bestDist then
                -- não pode ver parede simples (opcional)
                best, bestDist = v, d
            end
        end
    end
    -- Jogadores
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local rp = p.Character:FindFirstChild("HumanoidRootPart")
            if rp then
                local d = (rp.Position - rootPos).Magnitude
                if d < AIM_RANGE and d < bestDist then best, bestDist = p.Character, d end
            end
        end
    end
    return best
end

local function getHead(c)
    if not c then return nil end
    local h = c:FindFirstChild(AIM_BONE) or c:FindFirstChild("Head")
    return h and h.Position
end

-- ---------- Aimbot ----------
local aimConn
RunService.RenderStepped:Connect(function()
    if Settings.aimbot then
        local t = findTarget()
        local head = getHead(t)
        if head then
            pcall(function()
                local cam = camera
                camera.CFrame = CFrame.new(cam.Position, head)
            end)
        end
    end
end)

-- ---------- Auto Attack ----------
local autoConn
local function startAutoAttack()
    local attackKey = Enum.KeyCode.K -- tecla de ataque no blox strike (fist/katana)
    autoConn = RunService.Stepped:Connect(function()
        if Settings.autoAtk then
            pcall(function() UserInputService:InjectKeyDown(attackKey); wait(0.15); UserInputService:InjectKeyUp(attackKey) end)
        end
    end)
end

-- ---------- Speed ----------
local speedConn
local function startSpeed()
    speedConn = RunService.Stepped:Connect(function()
        if Settings.speed and Root then
            pcall(function() Root.Velocity = Root.CFrame.LookVector * SPRINT_AMT * 20 end)
        end
    end)
end

-- ---------- Noclip ----------
local noclipConn
local function startNoclip()
    noclipConn = RunService.Stepped:Connect(function()
        if Settings.noclip and Root then
            pcall(function() Root.CanCollide = false end)
        end
    end)
end

-- ---------- Botões ----------
local function makeOption(name, def, onChange)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, 0, 0.14, 0)
    row.BackgroundTransparency = 1
    row.Parent = Main
    label(name, UDim2.new(0.06,0,0,0), {X=0.6,Y=0.8}, THEME.text, row)
    local tg = toggle(def)
    tg.Position = UDim2.new(0.74,0,0,0)
    tg.Parent = row
    local function set(v)
        Settings[name] = v
        tg[1].BackgroundColor3 = v and THEME.accent or Color3.fromRGB(55,60,75)
        tg[1][1].Position = UDim2.new(v and 0.5 or 0,0,0,0)
        if onChange then onChange(v) end
    end
    set(def)
    local dragging = false, dragStart, startPos
    tg.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true; dragStart = i.Position; startPos = tg.Position
        end
    end)
    tg.InputChanged:Connect(function(i)
        if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
            local dx = i.Position.X - dragStart.X
            tg.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + dx, startPos.Y.Scale, startPos.Y.Offset)
        end
    end)
    tg.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)
    tg.MouseButton1Connect(function() set(not Settings[name]) end)
end

makeOption("aimbot",   false, function(v) if v then aimConn=RunService.RenderStepped:Connect(function() end) else end end)
makeOption("autoAtk",  false, function(v) if v and not autoConn then startAutoAttack() elseif not v and autoConn then autoConn:Disconnect(); autoConn=nil end end)
makeOption("speed",    false, function(v) if v and not speedConn then startSpeed() elseif not v and speedConn then speedConn:Disconnect(); speedConn=nil end end)
makeOption("noclip",   false, function(v) if v and not noclipConn then startNoclip() elseif not v and noclipConn then noclipConn:Disconnect(); noclipConn=nil end end)

