    local function makeToggle(label, configKey, order)
        local row = Instance.new("TextButton")
        row.Size = UDim2.new(1, 0, 0, 40)
        row.BackgroundColor3 = ROW_COLOR
        row.Text = ""
        row.LayoutOrder = order
        row.Parent = scroll
        
        local rCorner = Instance.new("UICorner")
        rCorner.CornerRadius = UDim.new(0, 6)
        rCorner.Parent = row

        local txt = Instance.new("TextLabel")
        txt.Size = UDim2.new(1, -60, 1, 0)
        txt.Position = UDim2.new(0, 10, 0, 0)
        txt.BackgroundTransparency = 1
        txt.Text = label
        txt.TextColor3 = Color3.fromRGB(200, 200, 200)
        txt.Font = Enum.Font.Gotham
        txt.TextSize = 14
        txt.TextXAlignment = Enum.TextXAlignment.Left
        txt.Parent = row

        local switchBg = Instance.new("Frame")
        switchBg.Size = UDim2.new(0, 36, 0, 20)
        switchBg.Position = UDim2.new(1, -46, 0.5, -10)
        switchBg.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
        switchBg.Parent = row
        
        local sCorner = Instance.new("UICorner")
        sCorner.CornerRadius = UDim.new(1, 0)
        sCorner.Parent = switchBg

        local dot = Instance.new("Frame")
        dot.Size = UDim2.new(0, 14, 0, 14)
        dot.Position = UDim2.new(0, 3, 0.5, -7)
        dot.BackgroundColor3 = Color3.fromRGB(180, 180, 180)
        dot.Parent = switchBg
        
