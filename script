local function make_tab(name, order)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, -12, 0, 34)
    b.Position = UDim2.fromOffset(6, 8 + (order - 1) * 40)
    b.BackgroundColor3 = state.bg_light
    b.Text = "  " .. name
    b.TextXAlignment = Enum.TextXAlignment.Left
    b.Font = Enum.Font.GothamMedium
    b.TextSize = 14
    b.TextColor3 = state.text
    b.Parent = tab_bar
    corner(b, 6)

    local page = Instance.new("Frame")
    page.Size = UDim2.fromScale(1, 1)
    page.BackgroundTransparency = 1
    page.Visible = false
    page.Parent = content

    tabs[name] = { button = b, page = page }
    pages[name] = page

    b.MouseButton1Click:Connect(function()
        for _, t in pairs(tabs) do t.page.Visible = false; t.button.BackgroundColor3 = state.bg_light end
        page.Visible = true
        b.BackgroundColor3 = state.accent
    end)

    return page
end

