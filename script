-- ============================================================
-- HELPERS
-- ============================================================
local function char()
    return LP.Character or LP.CharacterAdded:Wait()
end

local function root()
    local c = LP.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function find_remote(...)
    local patterns = {...}
    for _, obj in ipairs(RS:GetDescendants()) do
        if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
            local n = obj.Name:lower()
            for _, p in ipairs(patterns) do
                if n:find(p) then return obj end
            end
        end
    end
end

local function dump_remotes()
    print("========== XYN REMOTE DUMP ==========")
    for _, obj in ipairs(RS:GetDescendants()) do
        if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
            print(string.format("[%s] %s", obj.ClassName, obj:GetFullName()))
        end
    end
    print("=====================================")
end

local function nearest_target(max_dist)
    local r = root()
    if not r then return nil end
    local best, best_d = nil, max_dist or math.huge
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local n = obj.Name:lower()
            if n:find("egg") or n:find("brainrot") or n:find("pet") then
                local d = (obj.Position - r.Position).Magnitude
                if d < best_d then best, best_d = obj, d end
            end
        end
    end
    return best, best_d
end

