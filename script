-- ============================================================
-- AUTO FARM (NÍVEL + QUEST)
-- ============================================================

local function getQuestNPC()
    local quests = Workspace:FindFirstChild("Quests") or Workspace:FindFirstChild("Quests")
    if not quests then return nil end
    for _, npc in pairs(quests:GetChildren()) do
        if npc:IsA("Model") and npc:FindFirstChild("HumanoidRootPart") then
            local lvl = npc:GetAttribute("Level") or 0
            if LocalPlayer.Data.Level.Value >= lvl then
                return npc
            end
        end
    end
    return nil
end

local function autoFarmLevel()
    if not S.autoFarm then return end
    local hrp = getHRP()
    if not hrp then return end

    local questNPC = getQuestNPC()
    if questNPC then
        local questPos = questNPC.HumanoidRootPart.Position
        tweenTo(questPos + Vector3.new(0, 5, 0), 0.2)
        task.wait(0.5)
    end

    -- Procura inimigos próximos
    local enemies = {}
    for _, v in pairs(Workspace.Enemies:GetChildren()) do
        if v:IsA("Model") and v:FindFirstChild("HumanoidRootPart")
           and v:FindFirstChildOfClass("Humanoid") then
            local hum = v:FindFirstChildOfClass("Humanoid")
            if hum.Health > 0 then
                table.insert(enemies, v)
            end
        end
    end

    if #enemies > 0 then
        table.sort(enemies, function(a, b)
            local da = (a.HumanoidRootPart.Position - hrp.Position).Magnitude
            local db = (b.HumanoidRootPart.Position - hrp.Position).Magnitude
            return da < db
        end)

        local target = enemies[1]
        local targetPos = target.HumanoidRootPart.Position
        tweenTo(targetPos + Vector3.new(0, 5, 0), 0.1)

        -- Ataca com a ferramenta equipada
        local tool = getChar():FindFirstChildOfClass("Tool")
        if tool then
            tool:Activate()
        end

        -- Ataque com estilo de luta
        local combat = game:GetService("ReplicatedStorage")
            :FindFirstChild("Remotes")
        if combat then
            local attackRemote = combat:FindFirstChild("CommF_") 
                or combat:FindFirstChild("Comm")
            if attackRemote then
                attackRemote:FireServer()
            end
        end
    end
end

-- ============================================================
-- AUTO CHEST / FRUTA
-- ============================================================

local function autoCollectChest()
    if not S.autoChest then return end
    local hrp = getHRP()
    if not hrp then return end

    for _, v in pairs(Workspace:GetDescendants()) do
        if v.Name == "Chest" and v:IsA("MeshPart") then
            local dist = (v.Position - hrp.Position).Magnitude
            if dist < 500 then
                tweenTo(v.Position + Vector3.new(0, 3, 0), 0.1)
                task.wait(0.2)
            end
        end
    end
end

local function autoCollectFruit()
    if not S.autoFruit then return end
    local hrp = getHRP()
    if not hrp then return end

    for _, v in pairs(Workspace:GetDescendants()) do
        if v:IsA("Tool") and v:FindFirstChild("Handle")
           and v.Name:find("Fruit") then
            local dist = (v.Handle.Position - hrp.Position).Magnitude
            if dist < 500 then
                tweenTo(v.Handle.Position, 0.1)
                task.wait(0.2)
            end
        end
    end
end

-- ============================================================
-- KILL AURA
-- ============================================================

local function killAura()
    if not S.killAura then return end
    local hrp = getHRP()
    if not hrp then return end

    for _, v in pairs(Workspace.Enemies:GetChildren()) do
        if v:IsA("Model") and v:FindFirstChild("HumanoidRootPart")
           and v:FindFirstChildOfClass("Humanoid") then
            local hum = v:FindFirstChildOfClass("Humanoid")
            if hum.Health > 0 then
                local dist = (v.HumanoidRootPart.Position - hrp.Position).Magnitude
                if dist < 30 then
                    local combat = game:GetService("ReplicatedStorage")
                        :FindFirstChild("Remotes")
                    if combat then
                        local attackRemote = combat:FindFirstChild("CommF_")
                            or combat:FindFirstChild("Comm")
                        if attackRemote then
                            attackRemote:FireServer()
                        end
                    end
                end
            end
        end
    end
end

-- ============================================================
-- ESP
-- ============================================================

local espFolder = Instance.new("Folder")
espFolder.Name = "BF_Hub_ESP"
espFolder.Parent = Workspace

local function createESP(part, text, color)
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "ESP"
    billboard.Adornee = part
    billboard.Size = UDim2.new(0, 200, 0, 50)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = espFolder

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = color
    label.TextStrokeTransparency = 0
    label.TextScaled = true
    label.Parent = billboard
end

local function updateESP()
    espFolder:ClearAllChildren()

    if S.espPlayer then
        for _, plr in pairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character then
                local hrp = plr.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    createESP(hrp, plr.Name, Color3.fromRGB(255, 50, 50))
                end
            end
        end
    end

    if S.espFruit then
        for _, v in pairs(Workspace:GetDescendants()) do
            if v:IsA("Tool") and v:FindFirstChild("Handle")
               and v.Name:find("Fruit") then
                createESP(v.Handle, v.Name, Color3.fromRGB(50, 255, 50))
            end
        end
    end

    if S.espChest then
        for _, v in pairs(Workspace:GetDescendants()) do
            if v.Name == "Chest" and v:IsA("MeshPart") then
                createESP(v, "Baú", Color3.fromRGB(255, 215, 0))
            end
        end
    end

    if S.espNPC then
        for _, v in pairs(Workspace:GetChildren()) do
            if v:IsA("Model") and v:FindFirstChild("Humanoid")
               and v:FindFirstChild("HumanoidRootPart") then
                createESP(v.HumanoidRootPart, v.Name, Color3.fromRGB(100, 200, 255))
            end
        end
    end
end

