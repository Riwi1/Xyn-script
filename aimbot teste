local function makeToggle(parent, label, yPos, initial, callback)
    local row = create("Frame", {
        Size = UDim2.new(1, -20, 0, 30),
        Position = UDim2.new(0, 10, 0, yPos),
        BackgroundTransparency = 1,
        Parent = parent,
    })

    create("TextLabel", {
        Size = UDim2.new(0.6, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = label,
        TextColor3 = Color3.fromRGB(210, 210, 220),
        TextSize = 12,
        Font = Enum.Font.GothamMedium,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = row,
    })

    local track = create("Frame", {
        Size = UDim2.new(0, 42, 0, 22),
        Position = UDim2.new(1, -42, 0.5, -11),
        BackgroundColor3 = initial and CONFIG.FovColor or Color3.fromRGB(50, 50, 65),
        BorderSizePixel = 0,
        Parent = row,
    })
    create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = track })

    local knob = create("Frame", {
        Size = UDim2.new(0, 18, 0, 18),
        Position = initial and UDim2.new(1, -20, 0.5, -9) or UDim2.new(0, 2, 0.5, -9),
        BackgroundColor3 = Color3.fromRGB(240, 240, 250),
        BorderSizePixel = 0,
        Parent = track,
    })
    create("UICorner", { CornerRadius = UDim.new(1, 0), Parent = knob })

    local state = initial
    local function set(v)
        state = v
        tween(track, 0.22, { BackgroundColor3 = v and CONFIG.FovColor or Color3.fromRGB(50, 50, 65) })
        tween(knob, 0.22,
            { Position = v and UDim2.new(1, -20, 0.5, -9) or UDim2.new(0, 2, 0.5, -9) },
            Enum.EasingStyle.Quint
        )
        if callback then callback(v) end
    end

    local click = create("TextButton", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = "",
        Parent = row,
    })
    click.MouseButton1Click:Connect(function() set(not state) end)

    return { set = set, get = function() return state end }
end

