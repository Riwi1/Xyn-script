-- // HELPERS //
local function get_char(plr)
    return plr.Character or plr.CharacterAdded:Wait()
end

local function get_team(plr)
    return plr.Team and plr.Team.Name or "None"
end

local function has_los(char)
    if not config.aim_wall then return true end
    local head = char:FindFirstChild("Head")
    if not head then return false end
    
    local origin = Camera.CFrame.Position
    local dir = head.Position - origin
    local ray = RaycastParams.new()
    ray.FilterType = Enum.RaycastFilterType.Exclude
    ray.FilterDescendantsInstances = { LocalPlayer.Character }
    
    local res = Workspace:Raycast(origin, dir, ray)
    if res and not res.Instance:IsDescendantOf(char) then
        return false
    end
    return true
end

-- // ESP //
local esp_cache = {}

local function update_esp()
    if not config.esp_enabled then
        for _, obj in pairs(esp_cache) do obj.Enabled = false end
        return
    end

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            local head = plr.Character:FindFirstChild("Head")
            local root = plr.Character:FindFirstChild("HumanoidRootPart")
            
            local is_same_team = (get_team(plr) == get_team(LocalPlayer))
            local show = hum and hum.Health > 0 and head and root
            if config.esp_team and is_same_team then show = false end

            if show then
                local gui = esp_cache[plr]
                if not gui or not gui.Parent then
                    gui = Instance.new("BillboardGui")
                    gui.Name = plr.Name
                    gui.Adornee = head
                    gui.Size = UDim2.new(0, 100, 0, 50)
                    gui.StudsOffset = Vector3.new(0, 1.5, 0)
                    gui.AlwaysOnTop = true
                    gui.Parent = esp_folder
                    
                    local box = Instance.new("Frame", gui)
                    box.Size = UDim2.new(1, 0, 1, 0)
                    box.BackgroundTransparency = 1
                    local stroke = Instance.new("UIStroke", box)
                    stroke.Color = Color3.fromRGB(150, 90, 255)
                    stroke.Thickness = 1.5
                    
                    local name = Instance.new("TextLabel", gui)
                    name.Size = UDim2.new(1, 0, 0.5, 0)
                    name.Position = UDim2.new(0, 0, -0.35, 0)
                    name.BackgroundTransparency = 1
                    name.Text = plr.Name
                    name.TextColor3 = Color3.fromRGB(255, 255, 255)
                    name.TextStrokeTransparency = 0
                    name.Font = Enum.Font.GothamBold
                    name.TextSize = 14
                    
                    local dist = Instance.new("TextLabel", gui)
                    dist.Name = "Dist"
                    dist.Size = UDim2.new(1, 0, 0.5, 0)
                    dist.Position = UDim2.new(0, 0, 0.95, 0)
                    dist.BackgroundTransparency = 1
                    dist.TextColor3 = Color3.fromRGB(200, 200, 200)
                    dist.TextStrokeTransparency = 0
                    dist.Font = Enum.Font.Gotham
                    dist.TextSize = 12
                    dist.Text = config.esp_dist and "0m" or ""
                    
                    esp_cache[plr] = gui
                else
                    gui.Enabled = true
                    if config.esp_dist then
                        local d = math.floor((root.Position - Camera.CFrame.Position).Magnitude)
                        gui.Dist.Text = d .. "m"
                    else
                        gui.Dist.Text = ""
                    end
                end
            elseif esp_cache[plr] then
                esp_cache[plr].Enabled = false
            end
        end
    end
end

-- // AIMBOT //
local fov_circle = nil
pcall(function()
    fov_circle = Drawing.new("Circle")
    fov_circle.Thickness = 1.5
    fov_circle.Color = Color3.fromRGB(150, 90, 255)
    fov_circle.Filled = false
    fov_circle.NumSides = 60
    fov_circle.Transparency = 1
end)

local function get_target()
    local center = Camera.ViewportSize / 2
    local best, best_dist = nil, config.aim_fov
    
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local is_same_team = (get_team(plr) == get_team(LocalPlayer))
            if not (config.aim_team and is_same_team) then
                local part = plr.Character:FindFirstChild(config.aim_part)
                if part and has_los(plr.Character) then
                    local screen, on_screen = Camera:WorldToViewportPoint(part.Position)
                    -- Z > 0 garante que está na frente da câmera
                    if on_screen and screen.Z > 0 then
                        local dist = (Vector2.new(screen.X, screen.Y) - center).Magnitude
                        if dist < best_dist then
                            best_dist = dist
                            best = part
                        end
                    end
                end
            end
        end
    end
    return best
end

-- Prioridade máxima absoluta para vencer o camera lock do jogo
RunService:BindToRenderStep("XynAim", Enum.RenderPriority.Last.Value, function()
    if fov_circle then
        fov_circle.Position = Camera.ViewportSize / 2
        fov_circle.Radius = config.aim_fov
        fov_circle.Visible = config.aim_enabled
    end

    if config.aim_enabled and aim_held then
        local target = get_target()
        if target then
            local goal = CFrame.new(Camera.CFrame.Position, target.Position)
            Camera.CFrame = Camera.CFrame:Lerp(goal, config.aim_smooth)
        end
    end
end)

RunService.Heartbeat:Connect(update_esp)

UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.UserInputType == Enum.UserInputType.MouseButton2 then aim_held = true end
    if input.KeyCode == Enum.KeyCode.RightShift then
        if main then main.Visible = not main.Visible end
    end
end)

UserInputService.InputEnded:Connect(function(input, gp)
    if input.UserInputType == Enum.UserInputType.MouseButton2 then aim_held = false end
end)

