local function scan_eggs(max_dist)
    local char = LP.Character
    if not char then return {} end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return {} end

    local found = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local n = obj.Name:lower()
            if n:find("egg") or n:find("brainrot") or n:find("pet") then
                local d = (obj.Position - hrp.Position).Magnitude
                if d <= max_dist then
                    local val = egg_value(obj.Name)
                    table.insert(found, { part = obj, value = val, dist = d })
                end
            end
        end
    end
    return found
end

local function best_egg(max_dist)
    local eggs = scan_eggs(max_dist)
    if #eggs == 0 then return nil end

    if STATUS.prioritize_value then
        -- ordena por valor (maior primeiro), ignora os abaixo do mínimo
        local filtered = {}
        for _, e in ipairs(eggs) do
            if e.value >= STATUS.min_value then
                table.insert(filtered, e)
            end
        end
        if #filtered == 0 then filtered = eggs end
        table.sort(filtered, function(a, b) return a.value > b.value end)
        return filtered[1].part, filtered[1].value, filtered[1].dist
    else
        -- comportamento antigo: ovo mais próximo
        table.sort(eggs, function(a, b) return a.dist < b.dist end)
        return eggs[1].part, eggs[1].value, eggs[1].dist
    end
end

