-- ============================================================
local fovCircle = Drawing.new("Circle")
fovCircle.Visible = false
fovCircle.Thickness = 1.5
fovCircle.Filled = false
fovCircle.Color = ACCENT_COLOR
fovCircle.Transparency = 0.5
fovCircle.NumSides = 40

local espData = {}
local lockedTarget = nil

local function isTeammate(player)
    if not Config.TeamCheck then return false end
    if not player.Team then return false end
    if not LocalPlayer.Team then return false end
    return player.Team == LocalPlayer.Team
end

local function isVisible(targetPart, char)
    local origin = Camera.CFrame.Position
    local direction = (targetPart.Position - origin)
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    
    local filterList = {LocalPlayer.Character, Camera}
    for _, v in pairs(char:GetChildren()) do
        if v:IsA("Accessory") or v:IsA("Tool") or v:IsA("Hat") then
            table.insert(filterList, v)
        end
    end
    raycastParams.FilterDescendantsInstances = filterList
    
    local result = Workspace:Raycast(origin, direction, raycastParams)
    if result then
        if result.Instance:IsDescendantOf(char) then return true end
        return false
    end
    return true
end

local function getESP(player)
    if not espData[player] then
        espData[player] = {
            box = Drawing.new("Square"),
            name = Drawing.new("Text"),
            dist = Drawing.new("Text")
        }
        espData[player].box.Thickness = 1
        espData[player].name.Size = 14
        espData[player].name.Center = true
        espData[player].name.Outline = true
        espData[player].dist.Size = 12
        espData[player].dist.Center = true
        espData[player].dist.Outline = true
        espData[player].dist.Color = Color3.fromRGB(200, 200, 200)
    end
    return espData[player]
end

local function updateESP()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local char = player.Character
            local hrp = char:FindFirstChild("HumanoidRootPart")
            local head = char:FindFirstChild("Head")
            local hum = char:FindFirstChild("Humanoid")
            
            local d = getESP(player)
            
            -- Checagem pesada: Tem que estar vivo, não pode ser time, não pode estar no céu (>500)
            local isDead = not hum or hum.Health <= 0 or hum:GetState() == Enum.HumanoidStateType.Dead
            
            if not Config.ESPEnabled or isTeammate(player) or not hrp or not head or isDead or hrp.Position.Y > 500 then
                d.box.Visible = false
                d.name.Visible = false
                d.dist.Visible = false
                continue
            end

            local dist = (Camera.CFrame.Position - hrp.Position).Magnitude
            
            if dist > MAX_ESP_DISTANCE then
                d.box.Visible = false
                d.name.Visible = false
                d.dist.Visible = false
                continue
            end

            local topPos, onScreenTop = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
            local botPos, onScreenBot = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))

            if onScreenTop and onScreenBot and topPos.Z > 0 then
                local height = math.abs(topPos.Y - botPos.Y)
                local width = height * 0.6
                
                d.box.Visible = true
                d.box.Size = Vector2.new(width, height)
                d.box.Position = Vector2.new(topPos.X - width/2, topPos.Y)
                
                if Config.WallCheck then
                    d.box.Color = isVisible(head, char) and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 50, 50)
                else
                    local t = math.clamp(dist / MAX_ESP_DISTANCE, 0, 1)
                    d.box.Color = Color3.fromHSV(0.33 * (1 - t), 1, 1)
                end

                d.name.Visible = true
                d.name.Text = player.Name
                d.name.Position = Vector2.new(topPos.X, topPos.Y - 20)
                d.name.Color = Color3.fromRGB(255, 255, 255)

                d.dist.Visible = true
                d.dist.Text = math.floor(dist) .. "m"
                d.dist.Position = Vector2.new(topPos.X, botPos.Y + 5)
            else
                d.box.Visible = false
                d.name.Visible = false
                d.dist.Visible = false
            end
        end
    end
end

local function getClosestPlayer()
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    
    if lockedTarget and lockedTarget.Parent then
        local enemyChar = lockedTarget.Parent
        local enemyHum = enemyChar:FindFirstChild("Humanoid")
        local enemyPlayer = Players:GetPlayerFromCharacter(enemyChar)
        
        if enemyHum and enemyHum.Health > 0 and enemyHum:GetState() ~= Enum.HumanoidStateType.Dead and enemyPlayer and not isTeammate(enemyPlayer) then
            local screenPos, onScreen = Camera:WorldToViewportPoint(lockedTarget.Position)
            if onScreen and screenPos.Z > 0 then
                local dist = (center - Vector2.new(screenPos.X, screenPos.Y)).Magnitude
                if dist < Config.FOVSize then
                    return lockedTarget
                end
            end
        end
        lockedTarget = nil 
    end

    local closest = nil
    local shortestDist = Config.FOVSize

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local char = player.Character
            local hum = char:FindFirstChild("Humanoid")
            local hrp = char:FindFirstChild("HumanoidRootPart")
            
            local isDead = not hum or hum.Health <= 0 or hum:GetState() == Enum.HumanoidStateType.Dead
            
            if not isTeammate(player) and not isDead and hrp then
                if Config.WallCheck and not isVisible(hrp, char) then continue end
                
                local screenPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
                if onScreen and screenPos.Z > 0 then
                    local dist = (center - Vector2.new(screenPos.X, screenPos.Y)).Magnitude
                    if dist < shortestDist then
                        shortestDist = dist
                        closest = hrp
                    end
                end
            end
        end
    end
    
    lockedTarget = closest
    return closest
end

RunService.Heartbeat:Connect(function()
    updateESP()
end)

RunService.RenderStepped:Connect(function()
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    
    fovCircle.Visible = Config.AimbotEnabled and Config.ShowFOV
    if fovCircle.Visible then
        fovCircle.Position = center
        fovCircle.Radius = Config.FOVSize
    end

    if Config.AimbotEnabled then
        local target = getClosestPlayer()
        if target then
            -- O SEGREDO PARA O AIMBOT FUNCIONAR NO FPS:
            -- Muda o tipo de câmera para Scriptable pra o jogo não sobrescrever a mira
            Camera.CameraType = Enum.CameraType.Scriptable
            
            local currentCF = Camera.CFrame
            local safeSmooth = math.clamp(Config.Smoothness, 0.02, 0.85)
            local targetCF = CFrame.new(currentCF.Position, target.Position)
            
            Camera.CFrame = currentCF:Lerp(targetCF, safeSmooth)
        else
            -- Se não tem alvo, devolve o controle pro jogador
            Camera.CameraType = Enum.CameraType.Custom
        end
    else
        Camera.CameraType = Enum.CameraType.Custom
    end
end)

Players.PlayerRemoving:Connect(function(player)
    if espData[player] then
        espData[player].box:Remove()
        espData[player].name:Remove()
        espData[player].dist:Remove()
        espData[player] = nil
    end
end)

LocalPlayer.CharacterAdded:Connect(function()
    lockedTarget = nil
    Camera.CameraType = Enum.CameraType.Custom
end)
