-- =========================================================================
-- UTILITÁRIOS
-- =========================================================================
local function FindHumanoidRootPart(char: Model): Part?
	if not char then return nil end
	return char:FindFirstChildWhichIsA("HumanoidRootPart")
end

local function FindTargetPart(char: Model): BasePart?
	local root = FindHumanoidRootPart(char)
	if Config.PriorityTarget == "Head" and root then
		local head = char:FindFirstChild("Head", true) or (root and root.Parent:FindFirstChild("Head", true))
		if head and head:IsA("BasePart") then return head end
	end
	return root
end

local function PartToScreen(char: Model, part: BasePart): Vector2?
	local vp = Workspace.CurrentCamera
	local pos = vp:WorldToScreenPoint(part.Position)
	return Vector2.new(pos.X, pos.Y)
end

-- =========================================================================
-- LÓGICA DA MIRA (estado principal)
-- =========================================================================
local AimState = {
	Enabled   = false,
	LockedOn  = false,
	Target    = nil,
	Crosshair = Vector2.zero,
}

-- Calcula o raio em pixels do FOV para um dado raio em studs,
-- projetando a distância até o alvo no plano da tela.
local function ComputeFOVPixels(studRadius: number): number
	local cam = Workspace.CurrentCamera
	local dist = cam.CFrame.Position.Y -- altura aproximada da câmera ao chão
	-- aproximação por ângulo de campo (FOV natural da câmera)
	local fovDeg = cam.FOV or 70
	-- raio na tela ≈ distância * tan(halfFov) * (screenHeight / focalLen)
	-- simplificado e estável:
	local half = math.rad(fovDeg / 2)
	local pxPerStud = (cam.ViewSizeY / 2) / (math.tan(half) * math.max(dist, 1))
	return math.max(studRadius * pxPerStud, 0)
end

-- Loop de renderização: desenha o círculo FOV e procura o alvo.
local function RenderFrame()
	-- atualiza posição do crosshair/centro (centro da tela)
	local cam = Workspace.CurrentCamera
	AimState.Crosshair = cam.ImageSize / 2

	if not AimState.Enabled then return end

	local radiusStuds = Config.FOVRadius -- raio em studs (o slider controla o FOV em studs)
	local radiusPx    = ComputeFOVPixels(radiusStuds)

	-- atualiza o tamanho do círculo FOV na UI
	if FOVCircle and FOVCircle.Parent then
		FOVCircle.Size = UDim2.new(0, radiusPx * 2, 0, radiusPx * 2)
	end

	-- percorre personagens em busca do alvo mais próximo dentro do FOV
	local bestChar, bestPart, bestDist = nil, nil, math.huge
	for _, char in pairs(Workspace:GetChildren()) do
		if char ~= LocalPlayer.Character and char:IsA("Model") then
			local humanoid = char:FindFirstChildWhichIsA("Humanoid", true)
			if humanoid and humanoid.Health > 0 then
				local part = FindTargetPart(char)
				if part then
					local screen = PartToScreen(char, part)
					if screen then
						local d = (screen - AimState.Crosshair).Magnitude
						-- verifica distância em studs também
						local worldDist = (cam.CFrame.Position - part.Position).Magnitude
						if d <= radiusPx and worldDist <= Config.MaxDistance then
							if d < bestDist then
								bestChar, bestPart, bestDist = char, part, d
							end
						end
					end
				end
			end
		end
	end

	AimState.LockedOn = (bestChar ~= nil)
	AimState.Target   = bestChar

	if AimState.LockedOn and bestPart then
		local targetScreen = PartToScreen(bestChar, bestPart)
		if targetScreen then
			-- aplica a mira com suavidade (lerp por frame)
			local cam = Workspace.CurrentCamera
			local amt = math.min(Config.Smoothness, 1)
			local newCFrame = CFrame.new(
				cam.CFrame.Position,
				Vector3.new(targetScreen.X, targetScreen.Y, 0) -- simplificado: aponta pro ponto na tela
			)
			cam.CFrame = cam.CFrame:Lerp(newCFrame, amt)
		end
	end

	-- atualiza indicador de status
	if StatusText and StatusText.Parent then
		StatusText.Text = AimState.LockedOn and "BLOQUEADO" or "AGUARDANDO"
	end
end

RunService.RenderStepped:Connect(RenderFrame)

