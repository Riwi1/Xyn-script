local function find_remote(...)
    local pats = {...}
    for _, obj in ipairs(RS:GetDescendants()) do
        if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
            local n = obj.Name:lower()
            for _, p in ipairs(pats) do
                if n:find(p) then return obj end
            end
        end
    end
end

local function nearest_egg(max_dist)
    local char = LP.Character
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    local best, best_d = nil, max_dist or math.huge
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local n = obj.Name:lower()
            if n:find("egg") or n:find("brainrot") or n:find("pet") then
                local d = (obj.Position - hrp.Position).Magnitude
                if d < best_d then best, best_d = obj, d end
            end
        end
    end
    return best, best_d
end

