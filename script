-- ============================================================
-- ESP — Highlight em ovos/brainrots/pets
-- ============================================================
local function clear_esp()
    for obj, hl in pairs(EspCache) do
        if hl and hl.Parent then hl:Destroy() end
        EspCache[obj] = nil
    end
end

local function apply_esp(obj)
    if EspCache[obj] and EspCache[obj].Parent then return end
    local hl = Instance.new("Highlight")
    hl.FillColor         = _G.Xyn.esp_color
    hl.OutlineColor      = Color3.fromRGB(255, 255, 255)
    hl.FillTransparency  = 0.6
    hl.OutlineTransparency = 0
    hl.DepthMode         = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent            = obj
    EspCache[obj] = hl
end

spawn(function()
    while task.wait(0.5) do
        if _G.Xyn.esp_enabled then
            for _, obj in ipairs(workspace:GetDescendants()) do
                if obj:IsA("Model") or obj:IsA("BasePart") then
                    local n = obj.Name:lower()
                    if n:find("egg") or n:find("brainrot") or n:find("pet") then
                        apply_esp(obj)
                    end
                end
            end
        else
            clear_esp()
        end
    end
end)

-- ============================================================
-- LOOP — aplicar speed / jump
-- ============================================================
RunServ.Heartbeat:Connect(function()
    local char = Local.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    if hum.WalkSpeed ~= _G.Xyn.speed then hum.WalkSpeed = _G.Xyn.speed end
    if hum.UseJumpPower and hum.JumpPower ~= _G.Xyn.jump then hum.JumpPower = _G.Xyn.jump end
end)

