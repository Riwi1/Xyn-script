local function makeInput(parent, labelText, yPos, initialValue, onApply)
    create("TextLabel", {
        Size = UDim2.new(1, -20, 0, 16),
        Position = UDim2.new(0, 10, 0, yPos),
        BackgroundTransparency = 1,
        Text = labelText,
        TextColor3 = Color3.fromRGB(180, 180, 195),
        TextSize = 11,
        Font = Enum.Font.GothamMedium,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = parent,
    })

    local box = create("TextBox", {
        Size = UDim2.new(0.55, -8, 0, 26),
        Position = UDim2.new(0, 10, 0, yPos + 18),
        BackgroundColor3 = Color3.fromRGB(28, 28, 38),
        BorderSizePixel = 0,
        Text = tostring(initialValue),
        TextColor3 = Color3.fromRGB(230, 230, 240),
        PlaceholderText = "ex: 150",
        PlaceholderColor3 = Color3.fromRGB(120, 120, 140),
        TextSize = 12,
        Font = Enum.Font.GothamMedium,
        ClearTextOnFocus = false,
        Parent = parent,
    })
    create("UICorner", { CornerRadius = UDim.new(0, 6), Parent = box })
    local boxStroke = create("UIStroke", {
        Color = Color3.fromRGB(60, 60, 80),
        Thickness = 1,
        Transparency = 0.4,
        Parent = box,
    })

    box.Focused:Connect(function()
        tween(boxStroke, 0.2, { Color = CONFIG.FovColor, Transparency = 0.1 })
    end)
    box.FocusLost:Connect(function()
        tween(boxStroke, 0.2, { Color = Color3.fromRGB(60, 60, 80), Transparency = 0.4 })
    end)

    local apply = create("TextButton", {
        Size = UDim2.new(0.45, -8, 0, 26),
        Position = UDim2.new(0.55, 2, 0, yPos + 18),
        BackgroundColor3 = CONFIG.FovColor,
        BackgroundTransparency = 0.15,
        BorderSizePixel = 0,
        Text = "APLICAR",
        TextColor3 = Color3.fromRGB(10, 10, 15),
        TextSize = 12,
        Font = Enum.Font.GothamBold,
        AutoButtonColor = false,
        Parent = parent,
    })
    create("UICorner", { CornerRadius = UDim.new(0, 6), Parent = apply })

    apply.MouseEnter:Connect(function()
        tween(apply, 0.15, { BackgroundTransparency = 0 })
    end)
    apply.MouseLeave:Connect(function()
        tween(apply, 0.15, { BackgroundTransparency = 0.15 })
    end)

    local function flash(color)
        local orig = boxStroke.Color
        tween(boxStroke, 0.15, { Color = color, Transparency = 0.1 })
        task.delay(0.6, function()
            tween(boxStroke, 0.3, { Color = orig, Transparency = 0.4 })
        end)
    end

    apply.MouseButton1Click:Connect(function()
        local num = tonumber(box.Text)
        if not num or num ~= num or num < 10 or num > 1000 then
            flash(Color3.fromRGB(255, 70, 90))
            box.Text = "Inválido"
            task.delay(0.8, function() box.Text = tostring(initialValue) end)
            return
        end
        num = math.floor(num + 0.5)
        box.Text = tostring(num)
        flash(CONFIG.FovColor)
        if onApply then onApply(num) end
    end)

    return box
end

