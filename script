-- ============================================================
-- ESTADO
-- ============================================================
getgenv().AutoFarm = {
    Enabled     = false,
    TweenSpeed  = 0.15,
    AttackDelay = 0.1,
    Mode        = "Questline",  -- "Questline" ou "Mob"
}
local AF = getgenv().AutoFarm

-- ============================================================
-- UTILITÁRIOS
-- ============================================================
local function getChar()
    return LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
end

local function getHRP()
    local c = getChar()
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function getHum()
    local c = getChar()
    return c and c:FindFirstChildOfClass("Humanoid")
end

local function getEquippedTool()
    local c = getChar()
    return c and c:FindFirstChildOfClass("Tool")
end

local function getBackpack()
    return LocalPlayer:FindFirstChild("Backpack")
end

-- ============================================================
-- TWEEN MOVER
-- ============================================================
local function tweenTo(position, duration)
    local hrp = getHRP()
    if not hrp then return end

    duration = duration or AF.TweenSpeed
    local dist = (position - hrp.Position).Magnitude
    local scaled = math.clamp(duration * (dist / 50), 0.08, 1.5)

    local info = TweenInfo.new(scaled, Enum.EasingStyle.Linear)
    local goal = {CFrame = CFrame.new(position)}
    local tween = TweenService:Create(hrp, info, goal)
    tween:Play()
    tween.Completed:Wait()
end

-- ============================================================
-- ACEITAR / ABANDONAR MISSÃO
-- Lógica correta: InvokeServer, não FireServer
-- ============================================================
local function acceptQuest(questName, questNumber)
    pcall(function()
        CommF:InvokeServer("StartQuest", questName, questNumber)
    end)
end

local function abandonQuest()
    pcall(function()
        CommF:InvokeServer("AbandonQuest")
    end)
end

local function getCurrentQuest()
    local gui = LocalPlayer:FindFirstChild("PlayerGui")
    if not gui then return nil end
    local main = gui:FindFirstChild("Main")
    if not main then return nil end
    local quest = main:FindFirstChild("Quest")
    if quest and quest.Visible then
        return quest
    end
    return nil
end

-- ============================================================
-- ACEITAR MISSÃO BASEADO NO NÍVEL
-- Percorre os NPCs de quest em Workspace.Quests
-- ============================================================
local function getQuestNPC()
    local quests = workspace:FindFirstChild("Quests")
    if not quests then return nil end

    local level = LocalPlayer.Data and LocalPlayer.Data.Level.Value or 0
    local bestNPC, bestLevel = nil, 0

    for _, npc in pairs(quests:GetChildren()) do
        if npc:IsA("Model") and npc:FindFirstChild("HumanoidRootPart") then
            local npcLevel = npc:GetAttribute("Level") or 0
            if level >= npcLevel and npcLevel > bestLevel then
                bestNPC, bestLevel = npc, npcLevel
            end
        end
    end
    return bestNPC, bestLevel
end

local function startNearestQuest()
    local npc, lvl = getQuestNPC()
    if not npc then return false end

    local hrp = getHRP()
    if not hrp then return false end

    local npcPos = npc.HumanoidRootPart.Position
    local dist = (npcPos - hrp.Position).Magnitude

    -- Vai até o NPC
    if dist > 15 then
        tweenTo(npcPos + Vector3.new(0, 5, 0), 0.4)
        task.wait(0.3)
    end

    -- Aceita a missão (usa o nome do NPC como QuestName)
    local questName = npc.Name
    local questNumber = lvl
    acceptQuest(questName, questNumber)
    task.wait(0.5)
    return true
end

-- ============================================================
-- ENCONTRAR MOB DA MISSÃO ATUAL
-- Lê o texto da quest ativa e procura inimigos com esse nome
-- ============================================================
local function getQuestTarget()
    local quest = getCurrentQuest()
    if not quest then return nil end

    -- O nome do alvo está no texto da quest
    local targetName = nil
    for _, label in pairs(quest:GetDescendants()) do
        if label:IsA("TextLabel") and label.Text ~= "" then
            -- Procura linhas que contenham "Defeat" ou "Kill"
            local text = label.Text
            local match = text:match("Defeat%s+(.+)" ) or text:match("Kill%s+(.+)")
            if match then
                targetName = match:gsub("%s+$", "")
                break
            end
        end
    end

    if not targetName then return nil end

    -- Procura inimigos com esse nome em Workspace.Enemies
    local enemies = workspace:FindFirstChild("Enemies")
    if not enemies then return nil end

    local hrp = getHRP()
    if not hrp then return nil end

    local best, bestDist = nil, math.huge
    for _, mob in pairs(enemies:GetChildren()) do
        if mob:IsA("Model") and mob.Name == targetName
           and mob:FindFirstChild("HumanoidRootPart")
           and mob:FindFirstChildOfClass("Humanoid") then
            local hum = mob:FindFirstChildOfClass("Humanoid")
            if hum.Health > 0 then
                local d = (mob.HumanoidRootPart.Position - hrp.Position).Magnitude
                if d < bestDist then
                    best, bestDist = mob, d
                end
            end
        end
    end
    return best
end

-- ============================================================
-- ATACAR
-- Lógica: ativa a ferramenta equipada + usa o remoto
-- ============================================================
local function attack()
    local tool = getEquippedTool()
    if tool then
        pcall(function() tool:Activate() end)
    end
end

-- ============================================================
-- LOOP DE FARM QUESTLINE
-- ============================================================
local function farmQuestline()
    local quest = getCurrentQuest()

    if not quest then
        -- Sem missão ativa: aceita a próxima
        startNearestQuest()
        return
    end

    -- Já tem missão: procura o mob designado
    local target = getQuestTarget()
    if not target then
        -- Não achou o mob: se a missão já foi completada, entrega
        local questText = ""
        for _, label in pairs(quest:GetDescendants()) do
            if label:IsA("TextLabel") then
                questText = questText .. " " .. label.Text
            end
        end
        if questText:find("Return") or questText:find("completed") then
            abandonQuest()
            task.wait(0.5)
        end
        return
    end

    local hrp = getHRP()
    if not hrp then return end

    local mobPos = target.HumanoidRootPart.Position
    local dist = (mobPos - hrp.Position).Magnitude

    -- Vai até o mob
    if dist > 8 then
        tweenTo(mobPos + Vector3.new(0, 5, 0), 0.12)
    end

    -- Ataca
    attack()
    task.wait(AF.AttackDelay)
end

-- ============================================================
-- LOOP DE FARM POR MOB (modo alternativo)
-- ============================================================
local function farmMob()
    local enemies = workspace:FindFirstChild("Enemies")
    if not enemies then return end

    local hrp = getHRP()
    if not hrp then return end

    local best, bestDist = nil, math.huge
    for _, mob in pairs(enemies:GetChildren()) do
        if mob:IsA("Model") and mob:FindFirstChild("HumanoidRootPart")
           and mob:FindFirstChildOfClass("Humanoid") then
            local hum = mob:FindFirstChildOfClass("Humanoid")
            if hum.Health > 0 then
                local d = (mob.HumanoidRootPart.Position - hrp.Position).Magnitude
                if d < bestDist then
                    best, bestDist = mob, d
                end
            end
        end
    end

    if not best then return end

    local mobPos = best.HumanoidRootPart.Position
    if bestDist > 8 then
        tweenTo(mobPos + Vector3.new(0, 5, 0), 0.12)
    end
    attack()
    task.wait(AF.AttackDelay)
end

-- ============================================================
-- LOOP PRINCIPAL
-- ============================================================
task.spawn(function()
    while task.wait(0.1) do
        if not AF.Enabled then continue end

        local ok, err = pcall(function()
            if AF.Mode == "Questline" then
                farmQuestline()
            else
                farmMob()
            end
        end)

        if not ok then
            warn("[AutoFarm] erro:", err)
        end
    end
end)

